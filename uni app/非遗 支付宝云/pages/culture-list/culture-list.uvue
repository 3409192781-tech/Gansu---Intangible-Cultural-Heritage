<template>
	<view class="spot-list-page">
		<view class="search-bar">
			<view class="search-input-wrap" @click="focusSearch">
				<view class="search-icon">
					<view class="icon-lens"></view>
				</view>
				<input 
					class="search-input" 
					placeholder="搜索非遗项目" 
					v-model="searchText" 
					@confirm="handleSearch"
					:focus="searchFocused"
				/>
				<view class="search-clear" v-if="searchText" @click="clearSearch"></view>
			</view>
			<view class="filter-btn" @click="showFilter = true">
				<view class="filter-icon"></view>
				<text class="filter-text">筛选</text>
			</view>
		</view>
		
		<scroll-view class="category-tabs" scroll-x :show-scrollbar="false">
			<view class="tabs-inner">
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'all' }"
					@click="activeCategory = 'all'"
				>
					<text class="tab-text">全部</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'world' }"
					@click="activeCategory = 'world'"
				>
					<text class="tab-text">世界遗产</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'national' }"
					@click="activeCategory = 'national'"
				>
					<text class="tab-text">国家级非遗</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'provincial' }"
					@click="activeCategory = 'provincial'"
				>
					<text class="tab-text">省级非遗</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'city' }"
					@click="activeCategory = 'city'"
				>
					<text class="tab-text">市级非遗</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'art' }"
					@click="activeCategory = 'art'"
				>
					<text class="tab-text">传统美术</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'music' }"
					@click="activeCategory = 'music'"
				>
					<text class="tab-text">传统音乐</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'dance' }"
					@click="activeCategory = 'dance'"
				>
					<text class="tab-text">传统舞蹈</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'drama' }"
					@click="activeCategory = 'drama'"
				>
					<text class="tab-text">传统戏剧</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'skill' }"
					@click="activeCategory = 'skill'"
				>
					<text class="tab-text">传统技艺</text>
				</view>
			</view>
		</scroll-view>
		
		<view class="spot-count">
			<text class="count-text">共 {{filteredCultures.length}} 个非遗项目</text>
		</view>
		
		<scroll-view 
			class="spot-list" 
			scroll-y 
			@scrolltolower="loadMore"
			:refresher-enabled="true"
			:refresher-triggered="refreshing"
			@refresherrefresh="onRefresh"
		>
			<view class="spots-grid">
				<view 
					class="spot-card" 
					v-for="(culture, index) in displayCultures" 
					:key="index"
					@click="goToDetail(culture.id)"
				>
					<view class="spot-image-wrap">
						<image :src="culture.image" mode="aspectFill" class="spot-image"></image>
						<view class="spot-overlay"></view>
						<view class="spot-rating">
							<view class="star-icon"></view>
							<text class="rating-text">{{culture.rating}}</text>
						</view>
						<view class="spot-badge" v-if="hasLevelTag(culture.tags, '世界级')">
							<text class="badge-text">世界级</text>
						</view>
						<view class="spot-badge-world" v-if="hasLevelTag(culture.tags, '国家级')">
							<text class="badge-text-world">国家级</text>
						</view>
					</view>
					<view class="spot-info">
						<text class="spot-name">{{culture.name}}</text>
						<text class="spot-location">{{culture.location}}</text>
						<view class="spot-tags">
							<text class="spot-tag" v-for="(tag, tIndex) in culture.tags.slice(0, 2)" :key="tIndex">{{tag}}</text>
						</view>
					</view>
				</view>
			</view>
			
			<view class="load-more" v-if="loading">
				<view class="loading-icon"></view>
				<text class="loading-text">加载中...</text>
			</view>
			
			<view class="no-more" v-if="!loading && displayCultures.length >= filteredCultures.length && filteredCultures.length > 0">
				<text class="no-more-text">- 已经到底了 -</text>
			</view>
			
			<view class="empty-state" v-if="filteredCultures.length === 0">
				<view class="empty-icon"></view>
				<text class="empty-text">暂无相关非遗项目</text>
			</view>
		</scroll-view>
		
		<view class="filter-modal" v-if="showFilter" @click="showFilter = false">
			<view class="filter-content" @click.stop>
				<view class="filter-header">
					<text class="filter-title">筛选条件</text>
					<view class="filter-close" @click="showFilter = false"></view>
				</view>
				
				<view class="filter-section">
					<text class="filter-label">非遗等级</text>
					<view class="filter-options">
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '' }"
							@click="selectedLevel = ''"
						>
							<text class="option-text">全部</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '世界级' }"
							@click="selectedLevel = '世界级'"
						>
							<text class="option-text">世界级</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '国家级' }"
							@click="selectedLevel = '国家级'"
						>
							<text class="option-text">国家级</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '省级' }"
							@click="selectedLevel = '省级'"
						>
							<text class="option-text">省级</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '市级' }"
							@click="selectedLevel = '市级'"
						>
							<text class="option-text">市级</text>
						</view>
					</view>
				</view>
				
				<view class="filter-section">
					<text class="filter-label">非遗类型</text>
					<view class="filter-options">
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '' }"
							@click="selectedType = ''"
						>
							<text class="option-text">全部</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '传统美术' }"
							@click="selectedType = '传统美术'"
						>
							<text class="option-text">传统美术</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '传统音乐' }"
							@click="selectedType = '传统音乐'"
						>
							<text class="option-text">传统音乐</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '传统舞蹈' }"
							@click="selectedType = '传统舞蹈'"
						>
							<text class="option-text">传统舞蹈</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '传统戏剧' }"
							@click="selectedType = '传统戏剧'"
						>
							<text class="option-text">传统戏剧</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedType === '传统技艺' }"
							@click="selectedType = '传统技艺'"
						>
							<text class="option-text">传统技艺</text>
						</view>
					</view>
				</view>
				
				<view class="filter-actions">
					<view class="filter-btn-reset" @click="resetFilter">
						<text class="btn-text">重置</text>
					</view>
					<view class="filter-btn-confirm" @click="confirmFilter">
						<text class="btn-text">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { api } from '../../utils/api'
	
	const searchText = ref('')
	const searchFocused = ref(false)
	const showFilter = ref(false)
	const activeCategory = ref('all')
	const selectedLevel = ref('')
	const selectedType = ref('')
	const loading = ref(false)
	const refreshing = ref(false)
	const pageSize = 10
	const currentPage = ref(1)
	

	
	const allCultures = ref<any[]>([])

	onLoad(async () => {
		try {
			const res = await api.cultures.list(1, 100)
			allCultures.value = ((res as any)?.list) || []
		} catch (e) {
			uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
		}
	})

		const filteredCultures = computed(() => {
		let result = allCultures.value
		
		if (searchText.value) {
			const keyword = searchText.value.toLowerCase()
			result = result.filter(c => 
				c.name.toLowerCase().includes(keyword) ||
				c.location.toLowerCase().includes(keyword)
			)
		}
		
		if (selectedLevel.value) {
			result = result.filter(c => c.tags.some(t => t.includes(selectedLevel.value)))
		}
		
		if (selectedType.value) {
			result = result.filter(c => c.tags.some(t => t.includes(selectedType.value)))
		}
		
		if (activeCategory.value !== 'all') {
			const categoryMap: Record<string, string[]> = {
				'world': ['世界级'],
				'national': ['国家级'],
				'provincial': ['省级'],
				'city': ['市级'],
				'art': ['传统美术'],
				'music': ['传统音乐'],
				'dance': ['传统舞蹈'],
				'drama': ['传统戏剧'],
				'skill': ['传统技艺', '传统手工艺']
			}
			const keywords = categoryMap[activeCategory.value] || []
			result = result.filter(c => c.tags.some(t => keywords.some(k => t.includes(k))))
		}
		
		return result
	})
	
	const displayCultures = computed(() => {
		return filteredCultures.value.slice(0, currentPage.value * pageSize)
	})
	
	const focusSearch = () => {
		searchFocused.value = true
	}
	
	const clearSearch = () => {
		searchText.value = ''
	}
	
	const handleSearch = () => {
		currentPage.value = 1
	}
	
	const goToDetail = (id) => {
		uni.navigateTo({
			url: '/pages/detail/detail?id=' + id + '&type=culture'
		})
	}
	
	const hasLevelTag = (tags: string[], level: string) => {
		return tags.some(t => t.includes(level))
	}
	
	const loadMore = () => {
		if (loading.value) return
		if (displayCultures.value.length >= filteredCultures.value.length) return
		
		loading.value = true
		setTimeout(() => {
			currentPage.value++
			loading.value = false
		}, 500)
	}
	
	const onRefresh = () => {
		refreshing.value = true
		currentPage.value = 1
		setTimeout(() => {
			refreshing.value = false
		}, 1000)
	}
	
	const resetFilter = () => {
		selectedLevel.value = ''
		selectedType.value = ''
	}
	
	const confirmFilter = () => {
		currentPage.value = 1
		showFilter.value = false
	}
</script>

<style>
	.spot-list-page {
		min-height: 100vh;
		background: #F5E6D3;
		padding-bottom: env(safe-area-inset-bottom);
	}

