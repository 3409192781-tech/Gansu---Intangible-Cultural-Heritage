<template>
	<view class="my-list-page">
		<scroll-view scroll-y class="list-scroll">
			<view class="food-grid">
				<view
					class="food-card"
					v-for="(item, index) in displayList"
					:key="index"
					@click="goToDetail(item.id)"
				>
					<view class="food-image-wrap">
						<image :src="item.image" mode="aspectFill" class="food-image"></image>
						<view class="food-overlay"></view>
						<view class="food-corner"></view>
					</view>
					<view class="food-info">
						<text class="food-name">{{item.name}}</text>
						<view class="food-area-wrap">
							<view class="area-dot"></view>
							<text class="food-area">{{item.area || item.location}}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="empty-state" v-if="allList.length === 0">
				<view class="empty-icon"></view>
				<text class="empty-text">暂无美食记录</text>
				<text class="empty-sub">品尝过的美食将出现在这里</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import { api } from '../../utils/api'
	import { getDeviceId } from '../../utils/identity'

	const allList = ref<any[]>([])

	const loadData = async () => {
		try {
			const deviceId = getDeviceId()
			const data = await api.favorites.get(deviceId)
			if (data && data.foods) {
				allList.value = data.foods
			}
		} catch (err) {
			console.error('加载收藏失败:', err)
			allList.value = []
		}
	}

	const displayList = computed(() => allList.value)

	onMounted(() => {
		loadData()
	})

	const goToDetail = (id: string) => {
		uni.navigateTo({ url: '/pages/detail/detail?id=' + id + '&type=food' })
	}
</script>

<style>
	.my-list-page {
		min-height: 100vh;
		background: #F5E6D3;
	}

	.list-scroll {
		height: 100vh;
		padding: 20rpx 0;
	}

	.food-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		padding: 0 24rpx;
	}

	.food-card {
		width: 340rpx;
		background: #FFFFFF;
		border-radius: 20rpx;
		overflow: hidden;
		box-shadow: 0 6rpx 20rpx rgba(139, 69, 19, 0.12);
		margin-right: 24rpx;
		margin-bottom: 24rpx;
		border: 2rpx solid rgba(212, 168, 106, 0.15);
	}

	.food-card:nth-child(2n) {
		margin-right: 0;
	}

	.food-image-wrap {
		position: relative;
		width: 100%;
		height: 200rpx;
	}

	.food-image {
		width: 100%;
		height: 100%;
	}

	.food-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent, rgba(139, 69, 19, 0.25));
	}

	.food-corner {
		position: absolute;
		top: 0;
		right: 0;
		width: 44rpx;
		height: 44rpx;
		background: linear-gradient(135deg, #D4A86A 50%, transparent 50%);
	}

	.food-info {
		padding: 20rpx 24rpx;
	}

	.food-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #2C1810;
		display: block;
		margin-bottom: 10rpx;
		font-family: 'STKaiti', 'KaiTi', serif;
	}

	.food-area-wrap {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.area-dot {
		width: 8rpx;
		height: 8rpx;
		background: #C46210;
		border-radius: 50%;
		margin-right: 8rpx;
	}

	.food-area {
		font-size: 22rpx;
		color: #7A6B5A;
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 200rpx 0;
	}

	.empty-icon {
		width: 120rpx;
		height: 120rpx;
		background: #F5F5F5;
		border-radius: 50%;
		margin-bottom: 24rpx;
		position: relative;
	}

	.empty-icon:before {
		content: '';
		position: absolute;
		top: 40rpx;
		left: 30rpx;
		width: 60rpx;
		height: 3rpx;
		background: #CCC;
	}

	.empty-icon:after {
		content: '';
		position: absolute;
		top: 50rpx;
		left: 30rpx;
		width: 60rpx;
		height: 3rpx;
		background: #CCC;
	}

	.empty-text {
		font-size: 30rpx;
		color: #8B7355;
		margin-bottom: 12rpx;
	}

	.empty-sub {
		font-size: 24rpx;
		color: #B0A090;
	}
</style>
