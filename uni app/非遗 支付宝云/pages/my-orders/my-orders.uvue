<template>
	<view class="my-orders-page">
		<view class="orders-header">
			<view class="header-bg-layer">
				<view class="header-overlay"></view>
				<view class="header-pattern"></view>
			</view>
			<view class="header-content">
				<text class="header-title">我的订单</text>
			</view>
		</view>

		<view class="tab-bar">
			<view
				v-for="tab in tabs"
				:key="tab.key"
				:class="activeTab === tab.key ? 'tab-item tab-active' : 'tab-item'"
				@click="switchTab(tab.key)"
			>
				<text class="tab-text">{{ tab.label }}</text>
				<view v-if="activeTab === tab.key" class="tab-underline"></view>
			</view>
		</view>

		<scroll-view class="order-scroll" scroll-y refresher-enabled :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<view v-if="orderList.length > 0" class="order-list">
				<view class="order-card" v-for="order in orderList" :key="order.orderNo" @click="goToDetail(order.orderNo)">
					<view class="order-header">
						<text class="order-no">{{ order.orderNo }}</text>
						<view :class="'status-tag status-' + order.status">
							<text class="status-text">{{ statusLabel(order.status) }}</text>
						</view>
					</view>
					<view class="order-body">
						<image :src="order.productImage || '/static/logo.png'" mode="aspectFill" class="product-img"></image>
						<view class="product-info">
							<text class="product-name">{{ order.productName }}</text>
							<text class="product-price">¥{{ order.price }}</text>
						</view>
					</view>
					<view class="order-footer">
						<text class="order-time">{{ formatTime(order.createdAt) }}</text>
						<view class="order-actions">
							<view v-if="order.status === 'pending'" class="action-btn action-cancel" @click.stop="handleCancel(order)">
								<text class="action-text">取消订单</text>
							</view>
							<view v-if="order.status === 'pending' || order.status === 'paid'" class="action-btn action-contact" @click.stop="handleContact">
								<text class="action-text">联系客服</text>
							</view>
							<view v-if="order.status === 'shipped'" class="action-btn action-confirm" @click.stop="handleConfirm(order)">
								<text class="action-text">确认收货</text>
							</view>
							<view v-if="order.status === 'shipped' || order.status === 'completed'" class="action-btn action-refund" @click.stop="handleRefund(order)">
								<text class="action-text">申请退款</text>
							</view>
							<view v-if="order.status === 'cancelled' || order.status === 'refunding' || order.status === 'completed'" class="action-btn action-delete" @click.stop="handleDelete(order)">
								<text class="action-text">删除</text>
							</view>
						</view>
					</view>
					<view v-if="order.refundReason" class="refund-tip">
						<text class="refund-tip-text">退款原因：{{ order.refundReason }} — {{ order.refundStatus === 'pending' ? '处理中' : order.refundStatus === 'approved' ? '已同意' : '已拒绝' }}</text>
					</view>
				</view>
			</view>

			<view v-else class="empty-state">
				<view class="empty-icon">
					<view class="empty-box"></view>
				</view>
				<text class="empty-text">暂无订单</text>
				<text class="empty-sub">快去文创商城逛逛吧</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import { api } from '../../utils/api'
	import { getDeviceId } from '../../utils/identity'

	const tabs = [
		{ key: 'all', label: '全部' },
		{ key: 'pending', label: '待付款' },
		{ key: 'shipped', label: '已发货' },
		{ key: 'completed', label: '已完成' }
	]
	const activeTab = ref('all')
	const orderList = ref<any[]>([])
	const refreshing = ref(false)

	

	const statusLabel = (s: string) => {
		var m: Record<string, string> = {
			pending: '待付款', paid: '已付款', shipped: '已发货',
			completed: '已完成', cancelled: '已取消', refunding: '退款中'
		}
		return m[s] || s
	}

	const formatTime = (t: string) => {
		if (!t) return ''
		var d = new Date(t)
		var y = d.getFullYear()
		var M = String(d.getMonth() + 1).padStart(2, '0')
		var dd = String(d.getDate()).padStart(2, '0')
		var h = String(d.getHours()).padStart(2, '0')
		var mi = String(d.getMinutes()).padStart(2, '0')
		return y + '-' + M + '-' + dd + ' ' + h + ':' + mi
	}

	const loadOrders = async () => {
		try {
			var status = activeTab.value === 'all' ? undefined : activeTab.value
			var res = await api.orders.my(getDeviceId(), 1, status)
			orderList.value = (res && res.list) ? res.list : []
		} catch (e) {
			orderList.value = []
		}
	}

	const switchTab = (key: string) => {
		activeTab.value = key
		loadOrders()
	}

	const onRefresh = async () => {
		refreshing.value = true
		await loadOrders()
		refreshing.value = false
	}

	const goToDetail = (orderNo: string) => {
		uni.navigateTo({ url: '/pages/order-detail/order-detail?orderNo=' + orderNo })
	}

	const handleCancel = (order: any) => {
		uni.showModal({
			title: '取消订单',
			content: '确定要取消该订单吗？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await api.orders.cancel(order.orderNo, getDeviceId())
						uni.showToast({ title: '已取消', icon: 'success' })
						loadOrders()
					} catch (e: any) {
						uni.showToast({ title: e && e.message ? e.message : '取消失败', icon: 'none' })
					}
				}
			}
		})
	}

	const handleConfirm = (order: any) => {
		uni.showModal({
			title: '确认收货',
			content: '确认已收到商品？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await api.orders.confirm(order.orderNo, getDeviceId())
						uni.showToast({ title: '已确认收货', icon: 'success' })
						loadOrders()
					} catch (e: any) {
						uni.showToast({ title: e && e.message ? e.message : '操作失败', icon: 'none' })
					}
				}
			}
		})
	}

	const handleRefund = (order: any) => {
		if (order.refundStatus === 'pending') {
			uni.showToast({ title: '退款正在处理中', icon: 'none' })
			return
		}
		uni.showModal({
			title: '申请退款',
			content: '请输入退款原因：',
			editable: true,
			placeholderText: '如：商品与描述不符',
			success: async (res) => {
				if (res.confirm && res.content) {
					try {
						await api.orders.refund(order.orderNo, getDeviceId(), res.content)
						uni.showToast({ title: '退款申请已提交', icon: 'success' })
						loadOrders()
					} catch (e: any) {
						uni.showToast({ title: e && e.message ? e.message : '申请失败', icon: 'none' })
					}
				}
			}
		})
	}

	const handleDelete = (order: any) => {
		uni.showModal({
			title: '删除订单',
			content: '删除后订单将不再显示',
			success: async (res) => {
				if (res.confirm) {
					try {
						await api.orders.cancel(order.orderNo, getDeviceId())
						loadOrders()
					} catch (e) { }
				}
			}
		})
	}

	const handleContact = () => {
		uni.makePhoneCall({ phoneNumber: '13800000000' })
	}

	onMounted(() => {
		loadOrders()
	})
</script>

<style>
	.my-orders-page {
		min-height: 100vh;
		background: #F5E6D3;
		padding-bottom: 40rpx;
	}

	.orders-header {
		position: relative;
		padding: 40rpx 30rpx;
		overflow: hidden;
	}

	.header-bg-layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.header-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, rgba(139, 69, 19, 0.85), #8B4513);
	}

	.header-pattern {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23D4A86A' fill-opacity='0.05'%3E%3Cpath d='M0 20h20v20H0V20zm10 10h10v10H10V30z'/%3E%3C/g%3E%3C/svg%3E");
	}

	.header-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.header-title {
		font-size: 40rpx;
		font-weight: bold;
		color: #FFF8E7;
		font-family: 'STKaiti', 'KaiTi', serif;
		text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
	}

	.tab-bar {
		display: flex;
		flex-direction: row;
		background: #FFFFFF;
		margin: 0 24rpx;
		border-radius: 12rpx;
		box-shadow: 0 2rpx 8rpx rgba(139, 69, 19, 0.06);
		position: relative;
		z-index: 2;
		margin-top: -10rpx;
	}

	.tab-item {
		flex: 1;
		text-align: center;
		padding: 24rpx 0;
		position: relative;
	}

	.tab-text {
		font-size: 28rpx;
		color: #7A6B5A;
	}

	.tab-active .tab-text {
		color: #8B4513;
		font-weight: bold;
	}

	.tab-underline {
		position: absolute;
		bottom: 8rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 40rpx;
		height: 6rpx;
		background: #D4A86A;
		border-radius: 3rpx;
	}

	.order-scroll {
		padding: 20rpx 24rpx;
		min-height: calc(100vh - 300rpx);
	}

	.order-list {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.order-card {
		background: #FFFFFF;
		border-radius: 16rpx;
		padding: 24rpx;
		box-shadow: 0 2rpx 12rpx rgba(139, 69, 19, 0.06);
		border: 1rpx solid rgba(212, 168, 106, 0.12);
	}

	.order-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20rpx;
	}

	.order-no {
		font-size: 24rpx;
		color: #B0A090;
	}

	.status-tag {
		padding: 4rpx 16rpx;
		border-radius: 16rpx;
	}

	.status-pending { background: #FFF3CD; }
	.status-pending .status-text { color: #856404; }
	.status-paid { background: #D4EDDA; }
	.status-paid .status-text { color: #155724; }
	.status-shipped { background: #CCE5FF; }
	.status-shipped .status-text { color: #004085; }
	.status-completed { background: #E2E3E5; }
	.status-completed .status-text { color: #383D41; }
	.status-cancelled { background: #F8D7DA; }
	.status-cancelled .status-text { color: #721C24; }
	.status-refunding { background: #FFF0DB; }
	.status-refunding .status-text { color: #E07800; }

	.status-text {
		font-size: 22rpx;
		font-weight: bold;
	}

	.order-body {
		display: flex;
		flex-direction: row;
		margin-bottom: 20rpx;
	}

	.product-img {
		width: 120rpx;
		height: 120rpx;
		border-radius: 12rpx;
		flex-shrink: 0;
		background: #F5E6D3;
	}

	.product-info {
		flex: 1;
		margin-left: 20rpx;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.product-name {
		font-size: 28rpx;
		color: #2C1810;
		font-weight: 500;
		line-height: 1.4;
		margin-bottom: 8rpx;
	}

	.product-price {
		font-size: 34rpx;
		font-weight: bold;
		color: #C46210;
		font-family: 'STKaiti', 'KaiTi', serif;
	}

	.order-footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-top: 16rpx;
		border-top: 1rpx solid rgba(212, 168, 106, 0.1);
	}

	.order-time {
		font-size: 22rpx;
		color: #B0A090;
	}

	.order-actions {
		display: flex;
		flex-direction: row;
		gap: 12rpx;
	}

	.action-btn {
		padding: 8rpx 20rpx;
		border-radius: 24rpx;
		border: 1rpx solid;
	}

	.action-cancel { border-color: #B0A090; }
	.action-cancel .action-text { color: #7A6B5A; }
	.action-contact { border-color: #D4A86A; }
	.action-contact .action-text { color: #D4A86A; }
	.action-confirm { border-color: #4A8F6D; background: linear-gradient(135deg, #4A8F6D, #3E7A5B); }
	.action-confirm .action-text { color: #FFFFFF; }
	.action-refund { border-color: #D4695A; }
	.action-refund .action-text { color: #D4695A; }
	.action-delete { border-color: transparent; }
	.action-delete .action-text { color: #B0A090; }

	.action-text {
		font-size: 22rpx;
	}

	.refund-tip {
		margin-top: 12rpx;
		padding: 10rpx 16rpx;
		background: #FFF0DB;
		border-radius: 8rpx;
	}

	.refund-tip-text {
		font-size: 22rpx;
		color: #E07800;
	}

	/* Empty */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 120rpx 40rpx;
	}

	.empty-icon {
		margin-bottom: 24rpx;
	}

	.empty-box {
		width: 100rpx;
		height: 100rpx;
		border: 4rpx solid rgba(212, 168, 106, 0.3);
		border-radius: 16rpx;
		position: relative;
	}

	.empty-box::before {
		content: '';
		position: absolute;
		top: 20rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 40rpx;
		height: 6rpx;
		background: rgba(212, 168, 106, 0.4);
		border-radius: 3rpx;
	}

	.empty-box::after {
		content: '';
		position: absolute;
		top: 36rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 30rpx;
		height: 6rpx;
		background: rgba(212, 168, 106, 0.3);
		border-radius: 3rpx;
	}

	.empty-text {
		font-size: 30rpx;
		color: #7A6B5A;
		font-weight: bold;
		margin-bottom: 8rpx;
	}

	.empty-sub {
		font-size: 24rpx;
		color: #B0A090;
	}
</style>
