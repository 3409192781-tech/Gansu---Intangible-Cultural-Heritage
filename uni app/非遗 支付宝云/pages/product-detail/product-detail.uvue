<template>
	<view class="detail-page">
		<view class="swiper-section">
				<swiper
					class="detail-swiper"
					:indicator-dots="true"
					:autoplay="true"
					:interval="4000"
					:duration="800"
					:circular="true"
					indicator-color="rgba(255, 248, 231, 0.4)"
					indicator-active-color="#FFF8E7"
					@change="onSwiperChange"
				>
					<swiper-item v-for="(img, index) in detail.images" :key="index">
						<image :src="img" mode="aspectFill" class="detail-image"></image>
					</swiper-item>
				</swiper>
				<view class="image-overlay"></view>
				<view class="swiper-decoration"></view>
				<view class="image-counter">
					<text class="counter-text">{{currentIndex + 1}}/{{detail.images.length}}</text>
				</view>
		</view>

		<scroll-view scroll-y class="detail-scroll">
			<view class="detail-info">
				<view class="detail-header">
					<view class="title-wrap">
						<view class="title-decoration-left"></view>
						<text class="detail-title">{{detail.name}}</text>
						<view class="title-decoration-right"></view>
					</view>
					<view class="detail-rating">
						<view class="star-rating">
							<view class="star" v-for="i in 5" :key="i" :class="{'star-active': i <= ratingInt}">
								<view class="star-shape"></view>
							</view>
						</view>
						<text class="rating-value">{{detail.rating}}</text>
						<text class="rating-count">{{detail.reviews}}条评价</text>
					</view>
				</view>

				<view class="price-section">
					<view class="price-main">
						<text class="price-symbol">¥</text>
						<text class="price-value">{{detail.price}}</text>
						<text class="price-unit" v-if="detail.originalPrice">起</text>
					</view>
					<view class="price-original" v-if="detail.originalPrice">
						<text class="original-label">原价</text>
						<text class="original-value">¥{{detail.originalPrice}}</text>
					</view>
					<view class="price-sold" v-if="detail.sold">
						<text class="sold-text">已售 {{detail.sold > 999 ? (detail.sold / 1000).toFixed(1) + 'k' : detail.sold}}</text>
					</view>
				</view>

				<view class="detail-tags">
					<text class="detail-tag" v-for="(tag, index) in detail.tags" :key="index">{{tag}}</text>
				</view>

				<view class="detail-location">
					<view class="location-pin">
						<view class="pin-head"></view>
						<view class="pin-body"></view>
					</view>
					<text class="location-text">{{detail.location}}</text>
				</view>

				<view class="detail-divider"></view>

				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-desc">
							<view class="icon-book"></view>
						</view>
						<text class="section-title">产品故事</text>
						<view class="section-line"></view>
					</view>
					<text class="section-content">{{detail.description}}</text>
				</view>

				<view class="detail-divider"></view>

				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-culture">
							<view class="icon-flower"></view>
						</view>
						<text class="section-title">文化渊源</text>
						<view class="section-line"></view>
					</view>
					<view class="cultural-story" v-if="detail.culturalStory">
						<text class="cultural-text">{{detail.culturalStory}}</text>
					</view>
				</view>

				<view class="detail-divider"></view>

				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-spec">
							<view class="icon-ruler"></view>
						</view>
						<text class="section-title">规格说明</text>
						<view class="section-line"></view>
					</view>
					<view class="spec-list">
						<view class="spec-item" v-if="detail.material">
							<text class="spec-label">材质</text>
							<text class="spec-value">{{detail.material}}</text>
						</view>
						<view class="spec-item" v-if="detail.specification">
							<text class="spec-label">规格</text>
							<text class="spec-value">{{detail.specification}}</text>
						</view>
					</view>
				</view>

				<view class="detail-divider"></view>

				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-tips">
							<view class="icon-lightbulb"></view>
						</view>
						<text class="section-title">使用贴士</text>
						<view class="section-line"></view>
					</view>
					<view class="tips-list">
						<view class="tip-item" v-for="(tip, index) in detail.tips" :key="index">
							<view class="tip-dot"></view>
							<text class="tip-text">{{tip}}</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="detail-footer">
			<view class="footer-btn-primary" @click="handleBuy">
				<view class="btn-decoration"></view>
				<view class="btn-pattern"></view>
				<text class="footer-primary-text">立即购买</text>
			</view>
		</view>

		<view class="contact-modal" v-if="showBuy" @click="showBuy = false">
			<view class="contact-content" @click.stop>
				<view class="contact-header">
					<text class="contact-title">下单购买</text>
					<view class="contact-close" @click="showBuy = false"></view>
				</view>
				<view class="contact-body">
					<view class="contact-product-name">
						<text class="cpn-text">{{detail.name}} — ¥{{detail.price}}</text>
					</view>
					<view class="order-form">
						<view class="form-item">
							<text class="form-label">收货人</text>
							<input class="form-input" v-model="orderForm.customerName" placeholder="请输入收货人姓名">
						</view>
						<view class="form-item">
							<text class="form-label">手机号</text>
							<input class="form-input" v-model="orderForm.customerPhone" type="number" maxlength="11" placeholder="请输入收货手机号">
						</view>
						<view class="form-item">
							<text class="form-label">收货地址</text>
							<input class="form-input" v-model="orderForm.customerAddress" placeholder="请输入详细收货地址">
						</view>
					</view>
					<view class="contact-info">
						<text class="contact-info-text">下单后请联系客服完成支付：13800000000</text>
					</view>
					<view class="contact-methods">
						<view class="contact-method" @click="handleCall">
							<view class="method-icon method-icon-phone">
								<view class="icon-phone-shape"></view>
							</view>
							<text class="method-text">电话咨询</text>
							<view class="method-arrow"></view>
						</view>
						<view class="contact-method" @click="handleCopyWechat">
							<view class="method-icon method-icon-wechat">
								<view class="icon-wechat-shape"></view>
							</view>
							<text class="method-text">添加微信</text>
							<view class="method-arrow"></view>
						</view>
					</view>
					<view class="btn-row">
						<view class="submit-btn" @click="submitOrder">确认下单</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, reactive, computed } from 'vue'
	import { onLoad, onShareAppMessage } from '@dcloudio/uni-app'
	import { api } from '../../utils/api'
	import { getDeviceId, requireLogin } from '../../utils/identity'

	const currentIndex = ref(0)
	const showBuy = ref(false)
	const orderSubmitting = ref(false)

	const orderForm = reactive({
		customerName: '',
		customerPhone: '',
		customerAddress: ''
	})

	const onSwiperChange = (e: any) => {
		currentIndex.value = e.detail.current
	}

	const detail = reactive({
		id: '',
		name: '',
		rating: '4.5',
		reviews: '0',
		tags: [] as string[],
		location: '',
		price: 0,
		originalPrice: 0,
		sold: 0,
		description: '',
		culturalStory: '',
		material: '',
		specification: '',
		images: [] as string[],
		tips: [] as string[]
	})

	const ratingInt = computed(() => {
		const r = parseFloat(detail.rating)
		if (isNaN(r)) return 0
		return Math.floor(r)
	})

	const recordBrowse = (item: any) => {
		try {
			const raw = uni.getStorageSync('browseHistory') || '[]'
			const history = JSON.parse(raw)
			const exists = history.findIndex((h: any) => h.id === item.id)
			if (exists >= 0) {
				history.splice(exists, 1)
			}
			history.unshift({
				id: item.id,
				name: item.name,
				type: item.type || 'product',
				image: item.image,
				timestamp: Date.now()
			})
			if (history.length > 100) history.length = 100
			uni.setStorageSync('browseHistory', JSON.stringify(history))
		} catch (e) { }
	}


	const loadDetail = async (id: string) => {
		try {
			const data = await api.products.detail(id)
			if (data) {
				Object.assign(detail, data)
				if (!detail.images || detail.images.length === 0) {
					var img = (detail as any).image
					if (img && img.length > 0) { detail.images = [img] }
				}
				recordBrowse(detail)
				return
			}
		} catch (err) {
			console.error('加载产品详情失败:', err)
		}
		
	}

	onLoad((options: any) => {
		const id = options?.id || '301'
		loadDetail(id)
	})

	onShareAppMessage(() => {
		return {
			title: detail.name,
			path: '/pages/product-detail/product-detail?id=' + detail.id
		}
	})

	const handleBuy = () => {
		if (!requireLogin()) return
		if (!detail.stock || detail.stock <= 0) {
			uni.showToast({ title: '该产品库存不足', icon: 'none' })
			return
		}
		showBuy.value = true
		orderForm.customerName = ''
		orderForm.customerPhone = ''
		orderForm.customerAddress = ''
	}

	const submitOrder = async () => {
		if (!orderForm.customerName.trim()) { uni.showToast({ title: '请输入收货人', icon: 'none' }); return }
		if (!orderForm.customerPhone.trim() || orderForm.customerPhone.length < 11) { uni.showToast({ title: '请输入正确的手机号', icon: 'none' }); return }
		if (!orderForm.customerAddress.trim()) { uni.showToast({ title: '请输入收货地址', icon: 'none' }); return }
		if (orderSubmitting.value) return
		orderSubmitting.value = true
		try {
			// 1. 创建订单
			const order = await api.orders.create({
				productId: detail.id,
				productName: detail.name,
				productImage: detail.image || '',
				price: detail.price,
				customerName: orderForm.customerName,
				customerPhone: orderForm.customerPhone,
				customerAddress: orderForm.customerAddress,
				deviceId: getDeviceId()
			})
			
			if (!order || !order.orderNo) {
				throw new Error('创建订单失败')
			}
			
			// 2. 获取微信登录code
			const loginRes = await new Promise<any>((resolve, reject) => {
				uni.login({
					success: resolve,
					fail: reject
				})
			})
			
			// 3. 预下单获取支付参数
			const payParams = await api.payment.prePay(order.orderNo, loginRes.code)
			
			// 4. 调起微信支付
			await new Promise<void>((resolve, reject) => {
				uni.requestPayment({
					timeStamp: payParams.timeStamp,
					nonceStr: payParams.nonceStr,
					package: payParams.package,
					signType: payParams.signType || 'RSA',
					paySign: payParams.paySign,
					success: () => resolve(),
					fail: (err: any) => reject(err)
				})
			})
			
			showBuy.value = false
			uni.showToast({ title: '支付成功！', icon: 'success', duration: 2000 })
			setTimeout(() => {
				uni.navigateTo({ url: '/pages/order-detail/order-detail?orderNo=' + order.orderNo })
			}, 1500)
		} catch (e: any) {
			console.error('支付失败:', e)
			if (e.errMsg && e.errMsg.indexOf('cancel') >= 0) {
				uni.showToast({ title: '支付已取消', icon: 'none' })
			} else if (e.message) {
				uni.showToast({ title: e.message, icon: 'none' })
			} else {
				uni.showToast({ title: '支付失败，请重试', icon: 'none' })
			}
		}
		orderSubmitting.value = false
	}

	const handleCall = () => {
		uni.makePhoneCall({
			phoneNumber: '13800000000',
			fail: () => {
				uni.showToast({ title: '拨号失败', icon: 'none' })
			}
		})
	}

	const handleCopyWechat = () => {
		uni.setClipboardData({
			data: 'wx_********',
			success: () => {
				uni.showToast({ title: '微信号已复制', icon: 'success' })
			}
		})
	}
</script>

<style>
