	.icon-ruler:after {
		right: 4rpx;
	}

	.icon-tips {
		background: #D4A86A;
	}

	.icon-lightbulb {
		width: 20rpx;
		height: 20rpx;
		border: 3rpx solid #FFF8E7;
		border-radius: 50%;
		position: relative;
	}

	.icon-lightbulb:after {
		content: '';
		position: absolute;
		bottom: -8rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 6rpx;
		height: 6rpx;
		background: #FFF8E7;
		border-radius: 0 0 2rpx 2rpx;
	}

	.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #2C1810;
		font-family: 'STKaiti', 'KaiTi', serif;
		margin-right: 16rpx;
	}

