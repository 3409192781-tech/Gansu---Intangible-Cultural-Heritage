	}
	
	.title-decoration-left, .title-decoration-right {
		width: 24rpx;
		height: 2rpx;
		background: #D4A86A;
		margin: 0 16rpx;
	}
	
	.detail-title {
		font-size: 44rpx;
		font-weight: bold;
		color: #2C1810;
		font-family: 'STKaiti', 'KaiTi', serif;
	}
	
	.detail-rating {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}
	
	.star-rating {
		display: flex;
		flex-direction: row;
		margin-bottom: 6rpx;
	}
	
	.star {
		width: 24rpx;
