		left: 0;
		right: 0;
		padding: 30rpx 24rpx;
		background: linear-gradient(180deg, transparent, rgba(139, 69, 19, 0.7));
		pointer-events: none;
	}
	
	.image-title {
		font-size: 40rpx;
		font-weight: bold;
		color: #FFF8E7;
		font-family: 'STKaiti', 'KaiTi', serif;
		text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
	}
	
	.detail-info {
		background: #FFF8E7;
		padding: 28rpx 24rpx;
		position: relative;
		z-index: 1;
		margin-top: -20rpx;
		border-radius: 32rpx 32rpx 0 0;
	}
	
	.detail-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 20rpx;
	}
	
	.title-wrap {
		display: flex;
		flex-direction: row;
		align-items: center;
