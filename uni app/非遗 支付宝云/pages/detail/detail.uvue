		margin-left: 4rpx;
	}
	
	.star:first-child {
		margin-left: 0;
	}
	
	.star-shape {
		width: 100%;
		height: 100%;
		background: rgba(139, 69, 19, 0.15);
		clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
	}
	
	.star-active .star-shape {
		background: linear-gradient(135deg, #D4A86A, #E8C895);
	}
	
	.rating-value {
		font-size: 30rpx;
