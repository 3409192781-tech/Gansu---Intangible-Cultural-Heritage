		margin-top: 2rpx;
	}
	
	.detail-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 24rpx;
	}
	
	.detail-tag {
		font-size: 26rpx;
		background: linear-gradient(135deg, rgba(212, 168, 106, 0.15), rgba(212, 168, 106, 0.08));
		color: #8B4513;
		padding: 10rpx 24rpx;
		border-radius: 24rpx;
		margin-right: 14rpx;
		margin-bottom: 10rpx;
		border: 1rpx solid rgba(212, 168, 106, 0.3);
	}
	
	.detail-location {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 24rpx;
	}
	
	.location-pin {
		width: 24rpx;
		height: 32rpx;
		margin-right: 14rpx;
		position: relative;
	}
	
	.pin-head {
		width: 20rpx;
		height: 20rpx;
		background: linear-gradient(135deg, #4A8F6D, #3A7A5D);
		border-radius: 50%;
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		border: 2rpx solid #FFF8E7;
		box-shadow: 0 2rpx 6rpx rgba(74, 143, 109, 0.3);
	}
	
	.pin-body {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 0;
		height: 0;
		border-left: 8rpx solid transparent;
		border-right: 8rpx solid transparent;
		border-top: 12rpx solid #4A8F6D;
	}
	
	.location-text {
		font-size: 28rpx;
		color: #5A4B3A;
	}
	
	.detail-divider {
		height: 16rpx;
		background: linear-gradient(180deg, #FFF8E7, #F5E6D3, #FFF8E7);
		margin: 0 -24rpx;
	}
	
	.detail-section {
		padding: 24rpx 0;
	}
	
	.section-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 16rpx;
	}
	
	.section-icon {
		width: 48rpx;
		height: 48rpx;
		border-radius: 12rpx;
		margin-right: 16rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
	}
	
	.section-icon::before {
		content: '';
		position: absolute;
		top: 3rpx;
		left: 3rpx;
		right: 3rpx;
		bottom: 3rpx;
		border: 1rpx solid rgba(255, 255, 255, 0.25);
		border-radius: 8rpx;
	}
	
	.icon-spot {
		background: linear-gradient(135deg, #D4A86A, #B4884A);
	}
	
	.icon-time {
		background: linear-gradient(135deg, #C46210, #A45200);
	}
	
	.icon-ticket {
		background: linear-gradient(135deg, #CC8800, #AC7800);
	}
	
	.icon-transport {
		background: linear-gradient(135deg, #8B4513, #6B3410);
	}
	
	.icon-tips {
		background: linear-gradient(135deg, #4A8F6D, #3A7A5D);
	}
	
	
	
	.icon-mountain {
		width: 22rpx;
		height: 18rpx;
		position: relative;
	}
	
	.icon-mountain::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 0;
		border-left: 8rpx solid transparent;
		border-right: 8rpx solid transparent;
		border-bottom: 14rpx solid #FFF8E7;
	}
	
	.icon-mountain::after {
		content: '';
		position: absolute;
		bottom: 0;
		right: 0;
		width: 0;
		height: 0;
		border-left: 6rpx solid transparent;
		border-right: 6rpx solid transparent;
		border-bottom: 10rpx solid #FFF8E7;
	}
	
	.icon-clock {
		width: 20rpx;
		height: 20rpx;
		border: 2rpx solid #FFF8E7;
		border-radius: 50%;
		position: relative;
	}
	
	.icon-clock::before {
		content: '';
		position: absolute;
		top: 3rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 2rpx;
		height: 8rpx;
		background: #FFF8E7;
		border-radius: 1rpx;
	}
	
	.icon-clock::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 6rpx;
		height: 2rpx;
		background: #FFF8E7;
		border-radius: 1rpx;
		transform-origin: left center;
	}
	
	.icon-ticket-shape {
		width: 22rpx;
		height: 16rpx;
		background: #FFF8E7;
		border-radius: 3rpx;
		position: relative;
	}
	
	.icon-ticket-shape::before {
		content: '';
		position: absolute;
		left: -4rpx;
		top: 50%;
		transform: translateY(-50%);
		width: 6rpx;
		height: 6rpx;
		background: #CC8800;
		border-radius: 50%;
	}
	
	.icon-ticket-shape::after {
		content: '';
		position: absolute;
		right: -4rpx;
		top: 50%;
		transform: translateY(-50%);
		width: 6rpx;
		height: 6rpx;
		background: #CC8800;
		border-radius: 50%;
	}
	
	.icon-car {
		width: 24rpx;
		height: 16rpx;
		background: #FFF8E7;
		border-radius: 4rpx 4rpx 2rpx 2rpx;
		position: relative;
	}
	
	.icon-car::before {
		content: '';
		position: absolute;
		top: -4rpx;
		left: 4rpx;
		right: 4rpx;
		height: 6rpx;
		background: #FFF8E7;
		border-radius: 3rpx 3rpx 0 0;
	}
	
	.icon-car::after {
		content: '';
		position: absolute;
		bottom: -4rpx;
		left: 4rpx;
		width: 6rpx;
		height: 6rpx;
		background: #8B4513;
		border-radius: 50%;
		box-shadow: 10rpx 0 0 #8B4513;
	}
	
	.icon-lightbulb {
		width: 18rpx;
		height: 22rpx;
		background: #FFF8E7;
		border-radius: 50% 50% 40% 40%;
		position: relative;
	}
	
	.icon-lightbulb::before {
		content: '';
		position: absolute;
		bottom: -5rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 10rpx;
		height: 6rpx;
		background: #FFF8E7;
		border-radius: 0 0 2rpx 2rpx;
	}
	
	.icon-lightbulb::after {
		content: '';
		position: absolute;
		top: 5rpx;
		left: 50%;
		transform: translateX(-50%);
		width: 6rpx;
		height: 8rpx;
		background: rgba(74, 143, 109, 0.3);
		border-radius: 50%;
	}
	
	
	
	.icon-play::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-40%, -50%);
		width: 0;
		height: 0;
		border-top: 8rpx solid transparent;
		border-bottom: 8rpx solid transparent;
		border-left: 12rpx solid #FFF8E7;
	}
	
	.section-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #2C1810;
		font-family: 'STKaiti', 'KaiTi', serif;
	}
	
	.section-line {
		flex: 1;
		height: 2rpx;
		background: linear-gradient(90deg, #D4A86A, transparent);
		margin-left: 16rpx;
	}
	
	.section-content {
		font-size: 28rpx;
		color: #4A3B2A;
		line-height: 2;
