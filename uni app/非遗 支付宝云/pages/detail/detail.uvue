﻿<template>
	<view class="detail-page">
		<view class="swiper-section">
			<swiper 
				class="detail-swiper" 
				:indicator-dots="true" 
				:autoplay="true" 
				:interval="4000" 
				:duration="800" 
				:circular="true"
				indicator-color="rgba(255, 248, 231, 0.4)"
				indicator-active-color="#FFF8E7"
				@change="onSwiperChange"
			>
				<swiper-item v-for="(img, index) in (detail.images || [])" :key="index">
					<image :src="img" mode="aspectFill" class="detail-image"></image>
				</swiper-item>
			</swiper>
			<view class="image-overlay"></view>
			<view class="swiper-decoration"></view>
			<view class="image-counter">
				<text class="counter-text">{{currentIndex + 1}}/{{(detail.images || []).length}}</text>
			</view>
		</view>
		
		<scroll-view scroll-y class="detail-scroll">
			<view class="detail-info">
				<view class="detail-header">
					<view class="title-wrap">
						<view class="title-decoration-left"></view>
						<text class="detail-title">{{detail.name}}</text>
						<view class="title-decoration-right"></view>
					</view>
					<view class="detail-rating">
						<view class="star-rating">
							<view class="star" v-for="i in 5" :key="i" :class="{'star-active': i <= ratingInt}">
								<view class="star-shape"></view>
							</view>
						</view>
						<text class="rating-value">{{detail.rating}}</text>
						<text class="rating-count">{{detail.reviews}}条评价</text>
					</view>
				</view>
				
				<view class="detail-tags">
					<text class="detail-tag" v-for="(tag, index) in (detail.tags || [])" :key="index">{{tag}}</text>
				</view>
				
				<view class="detail-location">
					<view class="location-pin">
						<view class="pin-head"></view>
						<view class="pin-body"></view>
					</view>
					<text class="location-text">{{detail.location}}</text>
				</view>
				
				<view class="detail-divider"></view>
				
				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-spot">
							<view class="icon-mountain"></view>
						</view>
						<text class="section-title">{{sectionTitle}}</text>
						<view class="section-line"></view>
					</view>
					<text class="section-content">{{detail.description}}</text>
				</view>
				
				<view class="detail-divider"></view>
				
				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-time">
							<view class="icon-clock"></view>
						</view>
						<text class="section-title">开放时间</text>
						<view class="section-line"></view>
					</view>
					<text class="section-content">{{detail.openTime}}</text>
				</view>
				
				<view class="detail-divider"></view>
				
				<view class="detail-section" v-if="!isFood">
					<view class="section-header">
						<view class="section-icon icon-ticket">
							<view class="icon-ticket-shape"></view>
						</view>
						<text class="section-title">门票信息</text>
						<view class="section-line"></view>
					</view>
					<text class="section-content">{{detail.ticketInfo}}</text>
				</view>
				
				<view class="detail-divider"></view>
				
				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-transport">
							<view class="icon-car"></view>
						</view>
						<text class="section-title">交通指南</text>
						<view class="section-line"></view>
					</view>
					<text class="section-content">{{detail.transport}}</text>
				</view>
				
				<view class="detail-divider"></view>
				
				<view class="detail-section">
					<view class="section-header">
						<view class="section-icon icon-tips">
							<view class="icon-lightbulb"></view>
						</view>
						<text class="section-title">{{tipsTitle}}</text>
						<view class="section-line"></view>
					</view>
					<view class="tips-list">
						<view class="tip-item" v-for="(tip, index) in (detail.tips || [])" :key="index">
							<view class="tip-dot"></view>
							<text class="tip-text">{{tip}}</text>
						</view>
					</view>
				</view>
				
				<view class="detail-divider" v-if="isSpot && detail.heritages && detail.heritages.length > 0"></view>
				
				<view class="detail-section" v-if="isSpot && detail.heritages && detail.heritages.length > 0">
					<view class="section-header">
						<view class="section-icon icon-culture">
							<view class="icon-flower"></view>
						</view>
						<text class="section-title">关联非遗项目</text>
						<view class="section-line"></view>
					</view>
					<view class="heritage-list">
						<view class="heritage-item" v-for="(item, index) in (detail.heritages || [])" :key="index" @click="goToHeritage(item.id)">
							<view class="heritage-badge">{{item.level}}</view>
							<text class="heritage-name">{{item.name}}</text>
							<view class="heritage-arrow"></view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<view class="detail-footer">
<view class="footer-btn footer-btn-collect" @click="handleCollect">
				<view class="footer-icon" :class="isCollected ? 'icon-collect-active' : 'icon-collect'">
					<view class="icon-heart" :class="{'heart-active': isCollected}"></view>
				</view>
				<text class="footer-text">{{isCollected ? '已收藏' : '收藏'}}</text>
			</view>
			<view v-if="isSpot" class="footer-btn footer-btn-nav" @click="handleNav">
				<view class="footer-icon">
					<view class="icon-nav-shape"></view>
				</view>
				<text class="footer-text">导航</text>
			</view>
			<button class="footer-btn-primary" open-type="share">
				<view class="btn-decoration"></view>
				<view class="btn-pattern"></view>
				<text class="footer-primary-text">转发给朋友</text>
			</button>
		</view>
	</view>
	</template>

<script setup lang="uts">
	import { ref, reactive, computed } from 'vue'
	import { onLoad, onShareAppMessage } from '@dcloudio/uni-app'
	import { api } from '../../utils/api'
import { getDeviceId } from '../../utils/identity'
	
	const isCollected = ref(false)
	const currentIndex = ref(0)
	
	const onSwiperChange = (e: any) => {
		currentIndex.value = e.detail.current
	}
	
	const ratingInt = computed(() => {
		const r = parseFloat(detail.rating)
		if (isNaN(r)) return 0
		return Math.floor(r)
	})
	

	const detail = reactive({
		id: '',
		name: '',
		rating: '',
		reviews: '',
		tags: [],
		location: '',
		description: '',
		openTime: '',
		ticketInfo: '',
		transport: '',
		tips: [],
		images: [],		heritages: [],
		type: ''
	})
	
	const isSpot = computed(() => detail.type === 'spot')
		const isFood = computed(() => detail.type === 'food')
		const isCulture = computed(() => detail.type === 'culture')
const sectionLabels: Record<string, string> = { spot: '景点介绍', food: '美食介绍', culture: '非遗介绍', product: '产品介绍' }
const sectionTitle = computed(() => sectionLabels[detail.type] || '详细介绍')
const tipsLabels: Record<string, string> = { spot: '游玩贴士', food: '品尝贴士', culture: '参观贴士', product: '使用贴士' }
const tipsTitle = computed(() => tipsLabels[detail.type] || '小贴士')
	
	// 根据ID范围推断类型
	const detectType = (id: string): string => {
		const numId = parseInt(id)
		if (numId >= 100 && numId <= 199) return 'spot'
		if (numId >= 200 && numId <= 299) return 'food'
		return 'culture'
	}
	
	const fetchDetail = async (id: string, type: string) => {
		let res: any = null
		try {
			if (type === 'spot') res = await api.spots.detail(id)
			else if (type === 'food') res = await api.foods.detail(id)
			else if (type === 'culture') res = await api.cultures.detail(id)
			else return null
		} catch (e) {
			return null
		}
		if (res) {
			if (!res.images || res.images.length === 0) {
				res.images = res.image ? [res.image] : []
			}
			res.rating = String(res.rating ?? '')
			res.reviews = String(res.reviews ?? '')
		}
		return res
	}
	
	onLoad(async (options) => {
		const id = options?.id || '1'
		const type = options?.type || detectType(id)
		
		try {
			const apiData = await fetchDetail(id, type)
			if (apiData) {
				Object.assign(detail, apiData)
				// 防止 API 返回 null 覆盖 reactive 默认数组导致 v-for 崩溃
				detail.images = detail.images || []
				detail.tags = detail.tags || []
				detail.tips = detail.tips || []
				detail.heritages = detail.heritages || []
				detail.type = type
				refreshCollectStatus()
				return
			}
		} catch (e) {}
		
		uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
	})
	
	// 微信分享 — 页面级钩子
	onShareAppMessage(() => {
		return {
			title: detail.name,
			path: '/pages/detail/detail?id=' + detail.id + '&type=' + detail.type
		}
	})
	
	const refreshCollectStatus = async () => {
		try {
			const data = await api.favorites.check(getDeviceId(), detail.id)
			isCollected.value = !!(data && data.collected)
		} catch (e) {
			console.error('[fav] check failed:', e)
		}
	}

	const handleCollect = async () => {
		try {
			await api.favorites.toggle(getDeviceId(), detail.id)
			isCollected.value = !isCollected.value
			uni.showToast({ title: isCollected.value ? '收藏成功' : '取消收藏', icon: 'none' })
		} catch (e) {
			console.error('[fav] toggle failed:', e)
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}


	const handleNav = () => {
		if (detail.lat && detail.lng) {
			uni.openLocation({
				latitude: parseFloat(detail.lat),
				longitude: parseFloat(detail.lng),
				name: detail.name,
				address: detail.location,
				scale: 15
			})
		} else {
			uni.showToast({ title: '该景点暂无坐标信息', icon: 'none' })
		}
	}
	
	const handleBook = () => { uni.makePhoneCall({ phoneNumber: '13800000000' }) }
const goToHeritage = (id: string) => {
		uni.navigateTo({
			url: `/pages/detail/detail?id=${id}&type=culture`
		})
	}
</script>

<style>
	.detail-page {
		min-height: 100vh;
		background: #FFF8E7;
	}
	
	.detail-scroll {
		height: calc(100vh - 480rpx - 130rpx - env(safe-area-inset-bottom));
		width: 100%;
	}
	
	.swiper-section {
		position: relative;
		width: 100%;
		height: 480rpx;
	}
	
	.detail-swiper {
		width: 100%;
		height: 480rpx;
	}
	
	.detail-image {
		width: 100%;
		height: 100%;
	}
	
	.image-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, rgba(139, 69, 19, 0.1) 0%, rgba(139, 69, 19, 0.5) 100%);
		pointer-events: none;
	}
	
	.swiper-decoration {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 60rpx;
		background: linear-gradient(180deg, rgba(255, 248, 231, 0), #FFF8E7);
		pointer-events: none;
	}
	
	.image-counter {
		position: absolute;
		bottom: 80rpx;
		right: 32rpx;
		background: rgba(44, 24, 16, 0.6);
		padding: 8rpx 20rpx;
		border-radius: 20rpx;
		z-index: 10;
		backdrop-filter: blur(10px);
		border: 1rpx solid rgba(212, 168, 106, 0.3);
	}
	
	.counter-text {
		font-size: 24rpx;
		color: #FFF8E7;
		font-weight: 500;
	}
	
	.image-title-overlay {
		position: absolute;
