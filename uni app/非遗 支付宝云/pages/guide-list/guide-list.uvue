<template>
	<view class="spot-list-page">
		<!-- 搜索栏 -->
		<view class="search-bar">
			<view class="search-input-wrap" @click="focusSearch">
				<view class="search-icon">
					<view class="icon-lens"></view>
				</view>
				<input
					class="search-input"
					placeholder="搜索攻略"
					v-model="searchText"
					@confirm="handleSearch"
					:focus="searchFocused"
				/>
				<view class="search-clear" v-if="searchText" @click.stop="clearSearch"></view>
			</view>
			<view class="filter-btn" @click="openFilter">
				<view class="filter-icon"></view>
				<text class="filter-text">筛选</text>
			</view>
		</view>

		<!-- 分类标签 -->
		<scroll-view class="category-tabs" scroll-x :show-scrollbar="false">
			<view class="tabs-inner">
				<view class="tab-item" :class="{ active: activeCategory === 'all' }" @click="switchCategory('all')">
					<text class="tab-text">全部</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'family' }" @click="switchCategory('family')">
					<text class="tab-text">亲子游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'self_drive' }" @click="switchCategory('self_drive')">
					<text class="tab-text">自驾游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'photo' }" @click="switchCategory('photo')">
					<text class="tab-text">摄影游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'deep' }" @click="switchCategory('deep')">
					<text class="tab-text">深度游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'food' }" @click="switchCategory('food')">
					<text class="tab-text">美食游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'history' }" @click="switchCategory('history')">
					<text class="tab-text">文史游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'weekend' }" @click="switchCategory('weekend')">
					<text class="tab-text">周末游</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'budget' }" @click="switchCategory('budget')">
					<text class="tab-text">穷游</text>
				</view>
			</view>
		</scroll-view>

		<!-- 攻略列表 -->
		<scroll-view class="guide-list" scroll-y="true" @scrolltolower="loadMore" :refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<view class="guide-count">
				<text class="count-text">{{ filteredGuides.length }} 篇攻略</text>
			</view>

			<view class="card" v-for="item in displayGuides" :key="item.id" @click="goDetail(item.id)">
				<image class="card-img" :src="item.coverImage || defaultCover" mode="aspectFill" />
				<view class="card-body">
					<view class="card-title">{{ item.title }}</view>
					<view class="card-summary">{{ item.summary }}</view>
				<view class="card-meta">
						<view class="type-badge" :class="item.type"><text>{{ item.type === 'itinerary' ? '线路' : '游记' }}</text></view>
						<view class="cat-text"><text>{{ catLabel(item.category) }}</text></view>
						<text class="views">👁 {{ item.views || 0 }}</text>
				</view>
					<view class="card-tags" v-if="item.tags && item.tags.length">
						<text class="tag" v-for="tag in (item.tags || []).slice(0, 3)" :key="tag">{{ tag }}</text>
					</view>
				</view>
			</view>

			<view class="load-more" v-if="loading">加载中…</view>
			<view class="no-more" v-if="!loading && displayGuides.length >= filteredGuides.length && filteredGuides.length > 0">— 已加载全部 —</view>

			<view class="empty" v-if="!loading && filteredGuides.length === 0">
				<text class="empty-icon">📖</text>
				<text class="empty-text">暂无攻略</text>
				<text class="empty-sub">敬请期待更多精彩内容</text>
			</view>

			<view style="height: 40rpx"></view>
		</scroll-view>

		<!-- 筛选面板 (底部弹出) -->
		<view class="filter-overlay" v-if="showFilter" @click="showFilter = false">
			<view class="filter-panel" @click.stop>
				<view class="filter-header">
					<text class="filter-title">筛选</text>
					<view class="filter-close" @click="showFilter = false">
						<text class="close-text">✕</text>
					</view>
				</view>

				<view class="filter-section">
					<text class="filter-label">攻略类型</text>
					<view class="filter-options">
						<view class="filter-option" :class="{ active: tempType === '' }" @click="tempType = ''">
							<text class="option-text">全部</text>
						</view>
						<view class="filter-option" :class="{ active: tempType === 'article' }" @click="tempType = 'article'">
							<text class="option-text">游记文章</text>
						</view>
						<view class="filter-option" :class="{ active: tempType === 'itinerary' }" @click="tempType = 'itinerary'">
							<text class="option-text">线路行程</text>
						</view>
					</view>
				</view>

				<view class="filter-section">
					<text class="filter-label">攻略分类</text>
					<view class="filter-options">
						<view class="filter-option" :class="{ active: tempCategory === '' }" @click="tempCategory = ''">
							<text class="option-text">全部</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'family' }" @click="tempCategory = 'family'">
							<text class="option-text">亲子游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'self_drive' }" @click="tempCategory = 'self_drive'">
							<text class="option-text">自驾游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'photo' }" @click="tempCategory = 'photo'">
							<text class="option-text">摄影游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'deep' }" @click="tempCategory = 'deep'">
							<text class="option-text">深度游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'food' }" @click="tempCategory = 'food'">
							<text class="option-text">美食游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'history' }" @click="tempCategory = 'history'">
							<text class="option-text">文史游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'weekend' }" @click="tempCategory = 'weekend'">
							<text class="option-text">周末游</text>
						</view>
						<view class="filter-option" :class="{ active: tempCategory === 'budget' }" @click="tempCategory = 'budget'">
							<text class="option-text">穷游</text>
						</view>
					</view>
				</view>

				<view class="filter-actions">
					<view class="filter-btn-reset" @click="resetTempFilter">
						<text class="btn-text">重置</text>
					</view>
					<view class="filter-btn-confirm" @click="confirmFilter">
						<text class="btn-text">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue';
import { api } from '../../utils/api';

const defaultCover = 'https://img.gansu-culture.xyz/placeholder.jpg';

const catLabels: Record<string, string> = {
	family: '亲子游', self_drive: '自驾游', photo: '摄影游', deep: '深度游',
	food: '美食游', history: '文史游', weekend: '周末游', budget: '穷游'
};
const catLabel = (c: string) => catLabels[c] || c;

const searchText = ref('');
const searchFocused = ref(false);
const showFilter = ref(false);
const activeCategory = ref('all');
const selectedType = ref('');
const tempType = ref('');
const tempCategory = ref('');
const loading = ref(false);
const refreshing = ref(false);
const guides = ref<any[]>([]);
const currentPage = ref(1);
const pageSize = 30;

const filteredGuides = computed(() => guides.value);
const displayGuides = computed(() => filteredGuides.value.slice(0, currentPage.value * pageSize));

const loadData = async () => {
	loading.value = true;
	try {
		const data = await api.guides.list(1, 200, {
			category: activeCategory.value !== 'all' ? activeCategory.value : undefined,
			type: selectedType.value || undefined,
			keyword: searchText.value || undefined
		});
		if (data && data.list) {
			guides.value = data.list;
			currentPage.value = 1;
		}
	} catch (e) {}
	loading.value = false;
};

const handleSearch = () => loadData();
const clearSearch = () => { searchText.value = ''; loadData(); };
const focusSearch = () => { searchFocused.value = true; };

const switchCategory = (cat: string) => {
	activeCategory.value = cat;
	currentPage.value = 1;
	loadData();
};

const openFilter = () => {
	tempType.value = selectedType.value;
	tempCategory.value = activeCategory.value === 'all' ? '' : activeCategory.value;
	showFilter.value = true;
};

const resetTempFilter = () => {
	tempType.value = '';
	tempCategory.value = '';
};

const confirmFilter = () => {
	selectedType.value = tempType.value;
	activeCategory.value = tempCategory.value || 'all';
	showFilter.value = false;
	loadData();
};

const loadMore = () => {
	if (displayGuides.value.length >= filteredGuides.value.length) return;
	currentPage.value = currentPage.value + 1;
};

const onRefresh = async () => {
	refreshing.value = true;
	currentPage.value = 1;
	await loadData();
	refreshing.value = false;
};

const goDetail = (id: string) => {
	uni.navigateTo({ url: '/pages/guide-detail/guide-detail?id=' + id });
};

onMounted(() => { loadData(); });
</script>

<style>
