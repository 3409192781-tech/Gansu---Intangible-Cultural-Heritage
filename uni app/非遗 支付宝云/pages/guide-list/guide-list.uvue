	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.card-meta {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 12rpx;
}

