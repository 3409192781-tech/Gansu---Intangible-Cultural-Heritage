	flex: 1;
	height: 72rpx;
	font-size: 28rpx;
	color: #333;
}

.search-clear {
	width: 32rpx;
	height: 32rpx;
	background: #999;
	border-radius: 50%;
	position: relative;
}

.search-clear:before {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	width: 20rpx;
	height: 3rpx;
	background: #FFFFFF;
	transform: translate(-50%, -50%) rotate(45deg);
}

.search-clear:after {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	width: 20rpx;
	height: 3rpx;
	background: #FFFFFF;
	transform: translate(-50%, -50%) rotate(-45deg);
}

.filter-btn {
	padding: 0 24rpx;
	height: 72rpx;
	background: #8B4513;
	border-radius: 36rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.filter-icon {
	width: 24rpx;
	height: 24rpx;
	border: 3rpx solid #FFFFFF;
	border-radius: 6rpx;
	position: relative;
	margin-right: 8rpx;
}

.filter-icon:after {
	content: '';
	position: absolute;
	top: 8rpx;
	left: 8rpx;
	right: 8rpx;
	height: 3rpx;
	background: #FFFFFF;
}

