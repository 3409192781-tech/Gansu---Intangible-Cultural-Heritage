	width: 20rpx;
	height: 20rpx;
	border: 3rpx solid #8B4513;
	border-radius: 50%;
	position: relative;
}

.icon-lens:after {
	content: '';
	position: absolute;
	bottom: -6rpx;
	right: -6rpx;
	width: 10rpx;
	height: 3rpx;
	background: #8B4513;
	border-radius: 2rpx;
	transform: rotate(45deg);
	transform-origin: left center;
}

