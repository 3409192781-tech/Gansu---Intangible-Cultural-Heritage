	height: 100rpx;
	white-space: nowrap;
	padding: 14rpx 0;
}

.tabs-inner {
	display: inline-block;
	width: 1620rpx;
	padding-right: 24rpx;
	white-space: nowrap;
	font-size: 0;
}

.tab-item {
	display: inline-block;
	vertical-align: top;
	padding: 16rpx 32rpx;
	background: #F5F5F5;
	border-radius: 30rpx;
	margin-right: 16rpx;
	white-space: normal;
	font-size: 26rpx;
}

.tab-item.active {
	background: #D4A86A;
}

