	display: block;
	font-size: 24rpx;
	color: #8B4513;
	background: rgba(212,168,106,0.2);
	padding: 4rpx 16rpx;
	border-radius: 6rpx;
	margin-right: 12rpx;
	white-space: nowrap;
}

.cat-text text {
	font-size: 24rpx;
	color: #8B4513;
}


.views {
	font-size: 22rpx;
	color: #999;
	margin-left: auto;
}

.card-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 8rpx;
}

.tag {
	font-size: 22rpx;
	color: #D4A86A;
	background: rgba(212,168,106,0.1);
	padding: 4rpx 14rpx;
	border-radius: 6rpx;
}

.load-more, .no-more {
	text-align: center;
	padding: 24rpx;
	font-size: 24rpx;
	color: #999;
}

.empty {
	text-align: center;
	padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #2C1810; font-weight: 600; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; color: #999; }

