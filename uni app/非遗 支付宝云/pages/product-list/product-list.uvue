<template>
	<view class="product-list-page">
		<view class="search-bar">
			<view class="search-input-wrap" @click="focusSearch">
				<view class="search-icon">
					<view class="icon-lens"></view>
				</view>
				<input
					class="search-input"
					placeholder="搜索文创产品"
					v-model="searchText"
					@confirm="handleSearch"
					:focus="searchFocused"
				/>
				<view class="search-clear" v-if="searchText" @click.stop="clearSearch"></view>
			</view>
		</view>

		<scroll-view class="category-tabs" scroll-x :show-scrollbar="false">
			<view class="tabs-inner">
				<view class="tab-item" :class="{ active: activeCategory === 'all' }" @click="activeCategory = 'all'">
					<text class="tab-text">全部</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'artifact' }" @click="activeCategory = 'artifact'">
					<text class="tab-text">工艺品</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'textile' }" @click="activeCategory = 'textile'">
					<text class="tab-text">织物布艺</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'food_gift' }" @click="activeCategory = 'food_gift'">
					<text class="tab-text">美食礼品</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'stationery' }" @click="activeCategory = 'stationery'">
					<text class="tab-text">文房用品</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'home' }" @click="activeCategory = 'home'">
					<text class="tab-text">家居装饰</text>
				</view>
				<view class="tab-item" :class="{ active: activeCategory === 'accessory' }" @click="activeCategory = 'accessory'">
					<text class="tab-text">首饰配饰</text>
				</view>
			</view>
		</scroll-view>

		<view class="product-count">
			<text class="count-text">共 {{filteredProducts.length}} 件文创产品</text>
		</view>

		<scroll-view
			class="product-list"
			scroll-y
			@scrolltolower="loadMore"
			:refresher-enabled="true"
			:refresher-triggered="refreshing"
			@refresherrefresh="onRefresh"
		>
			<view class="products-list">
				<view
					class="product-card"
					v-for="(product, index) in displayProducts"
					:key="index"
					@click="goToDetail(product.id)"
				>
					<view class="product-image-wrap">
						<image :src="product.image" mode="aspectFill" class="product-image"></image>
						<view class="product-image-overlay"></view>
						<view class="product-price-badge">
							<text class="price-symbol">¥</text>
							<text class="price-value">{{product.price}}</text>
						</view>
					</view>
					<view class="product-info">
						<view class="product-name-row">
							<text class="product-name">{{product.name}}</text>
							<view class="product-badge-hot" v-if="product.isHot">
								<text class="badge-text">热销</text>
							</view>
							<view class="product-badge-new" v-if="product.isNew">
								<text class="badge-text">新品</text>
							</view>
						</view>
						<view class="product-tags">
							<text class="product-tag" v-for="(tag, tIndex) in product.tags.slice(0, 3)" :key="tIndex">{{tag}}</text>
						</view>
						<view class="product-meta">
							<text class="product-location">{{product.location}}</text>
							<view class="product-rating">
								<view class="star-icon"></view>
								<text class="rating-text">{{product.rating}}</text>
							</view>
						</view>
						<view class="product-bottom">
							<view class="product-original-price" v-if="product.originalPrice">
								<text class="original-text">¥{{product.originalPrice}}</text>
							</view>
							<view class="product-sold" v-if="product.sold">
								<text class="sold-text">已售 {{product.sold > 999 ? (product.sold / 1000).toFixed(1) + 'k' : product.sold}}</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="load-more" v-if="loading">
				<view class="loading-icon"></view>
				<text class="loading-text">加载中...</text>
			</view>

			<view class="no-more" v-if="!loading && displayProducts.length >= filteredProducts.length && filteredProducts.length > 0">
				<text class="no-more-text">- 已经到底了 -</text>
			</view>

			<view class="empty-state" v-if="filteredProducts.length === 0">
				<view class="empty-icon"></view>
				<text class="empty-text">暂无相关文创产品</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import { api } from '../../utils/api'

	const searchText = ref('')
	const searchFocused = ref(false)
	const activeCategory = ref('all')
	const loading = ref(false)
	const refreshing = ref(false)
	const pageSize = 50
	const currentPage = ref(1)

	const allProducts = ref<any[]>([])

	const loadData = async () => {
		try {
			const data = await api.products.list(currentPage.value, pageSize)
			if (data && data.list) {
				if (currentPage.value === 1) {
					allProducts.value = data.list
				} else {
					allProducts.value = allProducts.value.concat(data.list)
				}
			}
		} catch (err) {
			console.error('加载文创产品失败:', err)
			allProducts.value = []
			uni.showToast({ title: '加载失败，请下拉刷新', icon: 'none' })
		}
	}

	const filteredProducts = computed(() => {
		let result = allProducts.value

		if (searchText.value) {
			const keyword = searchText.value.toLowerCase()
			result = result.filter(p =>
				p.name.toLowerCase().includes(keyword) ||
				p.location.toLowerCase().includes(keyword) ||
				p.tags.some(t => t.toLowerCase().includes(keyword))
			)
		}

		if (activeCategory.value !== 'all') {
			result = result.filter(p => p.category === activeCategory.value)
		}

		return result
	})

	const displayProducts = computed(() => {
		return filteredProducts.value.slice(0, currentPage.value * pageSize)
	})

	onMounted(() => {
		loadData()
	})

	const focusSearch = () => {
		searchFocused.value = true
	}

	const clearSearch = () => {
		searchText.value = ''
	}

	const handleSearch = () => {
		currentPage.value = 1
	}

	const goToDetail = (id : string) => {
		uni.navigateTo({
			url: '/pages/product-detail/product-detail?id=' + id
		})
	}

	const loadMore = () => {
		if (loading.value) return
		if (displayProducts.value.length >= filteredProducts.value.length) return

		loading.value = true
		setTimeout(() => {
			currentPage.value++
			loading.value = false
		}, 500)
	}

	const onRefresh = () => {
		refreshing.value = true
		currentPage.value = 1
		setTimeout(() => {
			refreshing.value = false
		}, 1000)
	}
</script>

<style>
	.product-list-page {
		min-height: 100vh;
		background: #F5E6D3;
		padding-bottom: env(safe-area-inset-bottom);
	}

	.search-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 20rpx 24rpx;
		background: #FFFFFF;
	}

	.search-input-wrap {
		flex: 1;
		height: 72rpx;
		background: #F5F5F5;
		border-radius: 36rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 28rpx;
	}

	.search-icon {
		width: 32rpx;
		height: 32rpx;
		margin-right: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.icon-lens {
		width: 20rpx;
		height: 20rpx;
		border: 3rpx solid #8B4513;
		border-radius: 50%;
		position: relative;
	}

	.icon-lens:after {
		content: '';
		position: absolute;
		bottom: -6rpx;
		right: -6rpx;
		width: 10rpx;
		height: 3rpx;
		background: #8B4513;
		border-radius: 2rpx;
		transform: rotate(45deg);
		transform-origin: left center;
	}

	.search-input {
		flex: 1;
		height: 72rpx;
		font-size: 28rpx;
		color: #333;
	}

	.search-clear {
		width: 32rpx;
		height: 32rpx;
		background: #999;
		border-radius: 50%;
		position: relative;
	}

	.search-clear:before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 20rpx;
		height: 3rpx;
		background: #FFFFFF;
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.search-clear:after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 20rpx;
		height: 3rpx;
		background: #FFFFFF;
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	.category-tabs {
		width: 100%;
		background: #FFFFFF;
		height: 100rpx;
		white-space: nowrap;
		padding: 14rpx 0;
	}

	.tabs-inner {
		display: inline-block;
		width: 1400rpx;
		padding-right: 24rpx;
		white-space: nowrap;
		font-size: 0;
	}

	.tab-item {
		display: inline-block;
		vertical-align: top;
		padding: 16rpx 32rpx;
		background: #F5F5F5;
		border-radius: 30rpx;
		margin-right: 16rpx;
		white-space: normal;
		font-size: 26rpx;
	}

	.tab-item.active {
		background: #D4A86A;
	}

	.tab-item.active .tab-text {
		color: #FFFFFF;
	}

	.tab-text {
		font-size: 26rpx;
		color: #666;
	}

	.product-count {
		padding: 16rpx 24rpx;
	}

	.count-text {
		font-size: 24rpx;
		color: #8B7355;
	}

	.product-list {
		height: calc(100vh - 300rpx);
	}

	/* 单列横排卡片 */
	.products-list {
		padding: 0 24rpx;
	}

	.product-card {
		display: flex;
		flex-direction: row;
		margin-bottom: 20rpx;
		background: #FFFFFF;
		border-radius: 20rpx;
		overflow: hidden;
		box-shadow: 0 6rpx 20rpx rgba(139, 69, 19, 0.12);
		border: 2rpx solid rgba(212, 168, 106, 0.15);
	}

	.product-image-wrap {
		position: relative;
		width: 220rpx;
		height: 220rpx;
		flex-shrink: 0;
	}

	.product-image {
		width: 100%;
		height: 100%;
	}

	.product-image-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 60rpx;
		background: linear-gradient(transparent, rgba(0,0,0,0.3));
	}

	.product-price-badge {
		position: absolute;
		bottom: 10rpx;
		left: 10rpx;
		display: flex;
		flex-direction: row;
		align-items: baseline;
		background: rgba(196, 98, 16, 0.85);
		padding: 4rpx 12rpx;
		border-radius: 12rpx;
	}

	.price-symbol {
		font-size: 18rpx;
		color: #FFFFFF;
		margin-right: 2rpx;
	}

	.price-value {
		font-size: 26rpx;
		font-weight: bold;
		color: #FFFFFF;
	}

	.product-info {
		flex: 1;
		padding: 20rpx 20rpx 18rpx;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.product-name-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 8rpx;
	}

	.product-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #2C1810;
		font-family: 'STKaiti', 'KaiTi', serif;
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.product-badge-hot {
		background: #C46210;
		padding: 4rpx 10rpx;
		border-radius: 8rpx;
		margin-left: 10rpx;
		flex-shrink: 0;
	}

	.product-badge-new {
		background: #4A8F6D;
		padding: 4rpx 10rpx;
		border-radius: 8rpx;
		margin-left: 10rpx;
		flex-shrink: 0;
	}

	.badge-text {
		font-size: 20rpx;
		color: #FFFFFF;
	}

	.product-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 8rpx;
	}

	.product-tag {
		font-size: 22rpx;
		color: #8B4513;
		background: rgba(139, 69, 19, 0.08);
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		margin-right: 10rpx;
		margin-bottom: 4rpx;
	}

	.product-meta {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6rpx;
	}

	.product-location {
		font-size: 24rpx;
		color: #7A6B5A;
	}

	.product-rating {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.star-icon {
		width: 22rpx;
		height: 22rpx;
		background: #FFD700;
		clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
		margin-right: 4rpx;
	}

	.rating-text {
		font-size: 22rpx;
		color: #8B7355;
	}

	.product-bottom {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: auto;
	}

	.product-original-price {
		margin-right: 16rpx;
	}

	.original-text {
		font-size: 22rpx;
		color: #B0A090;
		text-decoration: line-through;
	}

	.product-sold {

	}

	.sold-text {
		font-size: 22rpx;
		color: #9A8B7A;
	}

	.load-more {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 30rpx 0;
	}

	.loading-icon {
		width: 36rpx;
		height: 36rpx;
		border: 3rpx solid #8B4513;
		border-top-color: transparent;
		border-radius: 50%;
		animation: spin 1s linear infinite;
		margin-right: 16rpx;
	}

	@keyframes spin {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}

	.loading-text {
		font-size: 26rpx;
		color: #999;
	}

	.no-more {
		text-align: center;
		padding: 30rpx 0;
	}

	.no-more-text {
		font-size: 24rpx;
		color: #CCC;
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 100rpx 0;
	}

	.empty-icon {
		width: 120rpx;
		height: 120rpx;
		background: #F5F5F5;
		border-radius: 50%;
		margin-bottom: 24rpx;
		position: relative;
	}

	.empty-icon:before {
		content: '';
		position: absolute;
		top: 40rpx;
		left: 30rpx;
		width: 60rpx;
		height: 3rpx;
		background: #CCC;
	}

	.empty-icon:after {
		content: '';
		position: absolute;
		top: 50rpx;
		left: 30rpx;
		width: 60rpx;
		height: 3rpx;
		background: #CCC;
	}

	.empty-text {
		font-size: 28rpx;
		color: #999;
	}
</style>
