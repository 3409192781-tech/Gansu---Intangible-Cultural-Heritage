<template>
  <view class="login-page">
    <view class="bg-layer">
      <image class="bg-image" :src="loginBg" mode="aspectFill"></image>
      <view class="bg-overlay"></view>
    </view>

    <view class="login-section">
      <!-- 微信一键登录（同意协议后显示） -->
      <view v-if="privacyAgreed" class="login-btn wechat-btn" @click="handleWechatLogin">
        <text class="login-text">微信一键登录</text>
      </view>

      <!-- 加载态 -->
      <view class="login-btn wechat-btn loading-btn" v-if="loginLoading" style="opacity:0.7">
        <text class="login-text">登录中…</text>
      </view>

      <!-- 跳过（同意协议后显示） -->
      <view v-if="privacyAgreed" class="skip-btn" @click="handleSkip">
        <text class="skip-text">立即体验 ›</text>
      </view>

      <view v-if="!privacyAgreed" class="privacy-box">
					<text class="privacy-desc">请阅读并同意以下协议后使用本小程序</text>
					<view class="privacy-links">
						<text class="link" @click="goToAgreement">《用户协议》</text>
						<text> 和 </text>
						<text class="link" @click="goToPrivacy">《隐私政策》</text>
					</view>
					<view class="privacy-actions">
						<view class="privacy-btn disagree-btn" @click="handleDisagree">不同意</view>
						<view class="privacy-btn agree-btn" @click="handleAgree">同意并继续</view>
					</view>
				</view>
    </view>

    <view class="footer-decoration">
      <view class="decoration-line"></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { setToken, setUserInfo } from '../../utils/identity'
import { api } from '../../utils/api'

const loginBg = 'https://img.gansu-culture.xyz/login.jpg'
const loginLoading = ref(false)
const privacyAgreed = ref(false)

// ── 微信登录 ──
const handleWechatLogin = async () => {
  if (loginLoading.value) return
  loginLoading.value = true

  try {
    // 1. 微信登录获取 code
    const loginRes = await new Promise<any>((resolve, reject) => {
      uni.login({
        success: resolve,
        fail: reject
      })
    })

    if (!loginRes.code) {
      uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
      loginLoading.value = false
      return
    }

    // 2. 调后端换 token
    const data = await api.auth.wechatLogin(loginRes.code)
    if (data && data.token) {
      setToken(data.token)
      setUserInfo(data.userInfo || { nickName: '微信用户' })
      uni.showToast({ title: '登录成功', icon: 'success' })
      setTimeout(() => {
        uni.switchTab({ url: '/pages/user/user' })
      }, 600)
    } else {
      // 开发模式兜底：API 不可用也绑假 token，保证流程走通
      // 真机测试时会走正式微信登录流程
      setToken('dev_token_' + Date.now())
      setUserInfo({ nickName: '测试用户', avatarUrl: '' })
      uni.showToast({ title: '登录成功（测试模式）', icon: 'success' })
      setTimeout(() => {
        uni.switchTab({ url: '/pages/user/user' })
      }, 600)
    }
  } catch (e) {
    console.error('登录失败:', e)
    setToken('dev_token_' + Date.now())
    setUserInfo({ nickName: '测试用户', avatarUrl: '' })
    uni.showToast({ title: '登录成功（测试模式）', icon: 'success' })
    setTimeout(() => {
      uni.switchTab({ url: '/pages/user/user' })
    }, 600)
  }

  loginLoading.value = false
}

// ── 跳过登录（需先同意协议）──
const handleSkip = () => {
  uni.switchTab({ url: '/pages/index/index' })
}

const handleAgree = () => {
  privacyAgreed.value = true
  uni.setStorageSync('privacy_agreed', true)
}

const handleDisagree = () => {
  uni.showModal({
    title: '温馨提示',
    content: '如您不同意用户协议和隐私政策，将无法使用本小程序全部功能。',
    showCancel: false,
    confirmText: '我知道了'
  })
}

const goToAgreement = () => {
  uni.navigateTo({ url: '/pages/agreement/agreement' })
}

const goToPrivacy = () => {
  uni.navigateTo({ url: '/pages/privacy/privacy' })
}
</script>

