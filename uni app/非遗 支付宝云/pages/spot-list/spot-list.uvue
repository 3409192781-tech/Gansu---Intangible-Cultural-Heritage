<template>
	<view class="spot-list-page">
		<view class="search-bar">
			<view class="search-input-wrap" @click="focusSearch">
				<view class="search-icon">
					<view class="icon-lens"></view>
				</view>
				<input 
					class="search-input" 
					placeholder="搜索景点名称" 
					v-model="searchText" 
					@confirm="handleSearch"
					:focus="searchFocused"
				/>
				<view class="search-clear" v-if="searchText" @click="clearSearch"></view>
			</view>
			<view class="filter-btn" @click="showFilter = true">
				<view class="filter-icon"></view>
				<text class="filter-text">筛选</text>
			</view>
		</view>
		
		<scroll-view class="category-tabs" scroll-x :show-scrollbar="false">
			<view class="tabs-inner">
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'all' }"
					@click="activeCategory = 'all'"
				>
					<text class="tab-text">全部</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === '5a' }"
					@click="activeCategory = '5a'"
				>
					<text class="tab-text">5A景区</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'world' }"
					@click="activeCategory = 'world'"
				>
					<text class="tab-text">世界遗产</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'nature' }"
					@click="activeCategory = 'nature'"
				>
					<text class="tab-text">自然景观</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'culture' }"
					@click="activeCategory = 'culture'"
				>
					<text class="tab-text">人文古迹</text>
				</view>
				<view 
					class="tab-item" 
					:class="{ active: activeCategory === 'ethnic' }"
					@click="activeCategory = 'ethnic'"
				>
					<text class="tab-text">民族风情</text>
				</view>
			</view>
		</scroll-view>
		
		<view class="spot-count">
			<text class="count-text">共 {{filteredSpots.length}} 个景点</text>
		</view>
		
		<scroll-view class="spot-list" scroll-y @scrolltolower="loadMore" :refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<view class="spots-grid">
				<view class="spot-row" v-for="(spot, index) in displaySpots" :key="index" @click="goToDetail(spot.id)">
					<view class="spot-row-img">
						<image :src="spot.image" mode="aspectFill" class="spot-row-image"></image>
						<view class="spot-row-badge" v-if="has5ATag(spot.tags)">
							<text class="sr-badge-text">5A</text>
						</view>
						<view class="spot-row-badge-world" v-if="hasWorldTag(spot.tags)">
							<text class="sr-badge-world-text">世界遗产</text>
						</view>
					</view>
					<view class="spot-row-info">
						<view class="spot-row-header">
							<text class="spot-row-name">{{spot.name}}</text>
							<view class="spot-row-rating">
								<view class="sr-star"></view>
								<text class="sr-rating-text">{{spot.rating}}</text>
							</view>
						</view>
						<view class="spot-row-tags">
							<text class="sr-tag" v-for="(tag, tIndex) in spot.tags.slice(0, 3)" :key="tIndex">{{tag}}</text>
						</view>
						<view class="spot-row-meta">
							<view class="sr-location-wrap">
								<view class="sr-dot"></view>
								<text class="sr-location">{{spot.location}}</text>
							</view>
							<text class="sr-reviews" v-if="spot.reviews">{{spot.reviews}}条评价</text>
						</view>
					</view>
				</view>
			</view>
			<view class="load-more" v-if="loading">
				<view class="loading-icon"></view>
				<text class="loading-text">加载中...</text>
			</view>
			<view class="no-more" v-if="!loading && displaySpots.length >= filteredSpots.length && filteredSpots.length > 0">
				<text class="no-more-text">- 已经到底了 -</text>
			</view>
			<view class="empty-state" v-if="filteredSpots.length === 0">
				<view class="empty-icon"></view>
				<text class="empty-text">暂无相关景点</text>
			</view>
		</scroll-view>		
		<view class="filter-modal" v-if="showFilter" @click="showFilter = false">
			<view class="filter-content" @click.stop>
				<view class="filter-header">
					<text class="filter-title">筛选条件</text>
					<view class="filter-close" @click="showFilter = false"></view>
				</view>
				
				<view class="filter-section">
					<text class="filter-label">景区等级</text>
					<view class="filter-options">
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '' }"
							@click="selectedLevel = ''"
						>
							<text class="option-text">全部</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '5A' }"
							@click="selectedLevel = '5A'"
						>
							<text class="option-text">AAAAA</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedLevel === '4A' }"
							@click="selectedLevel = '4A'"
						>
							<text class="option-text">AAAA</text>
						</view>
					</view>
				</view>
				
				<view class="filter-section">
					<text class="filter-label">所在城市</text>
					<view class="filter-options">
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '' }"
							@click="selectedCity = ''"
						>
							<text class="option-text">全部</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '兰州' }"
							@click="selectedCity = '兰州'"
						>
							<text class="option-text">兰州</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '酒泉' }"
							@click="selectedCity = '酒泉'"
						>
							<text class="option-text">酒泉</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '天水' }"
							@click="selectedCity = '天水'"
						>
							<text class="option-text">天水</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '张掖' }"
							@click="selectedCity = '张掖'"
						>
							<text class="option-text">张掖</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '嘉峪关' }"
							@click="selectedCity = '嘉峪关'"
						>
							<text class="option-text">嘉峪关</text>
						</view>
						<view 
							class="filter-option" 
							:class="{ active: selectedCity === '临夏' }"
							@click="selectedCity = '临夏'"
						>
							<text class="option-text">临夏</text>
						</view>
					</view>
				</view>
				
				<view class="filter-actions">
					<view class="reset-btn" @click="resetFilter">
						<text class="btn-text">重置</text>
					</view>
					<view class="confirm-btn" @click="applyFilter">
						<text class="btn-text">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { api } from '../../utils/api'
	
	const searchText = ref('')
	const searchFocused = ref(false)
	const activeCategory = ref('all')
	const showFilter = ref(false)
	const selectedLevel = ref('')
	const selectedCity = ref('')
	const loading = ref(false)
	const refreshing = ref(false)
	const pageSize = 10
	const currentPage = ref(1)
	
	const allSpots = ref<any[]>([])

	onLoad(async () => {
		try {
			const res = await api.spots.list(1, 100)
			allSpots.value = ((res as any)?.list) || []
		} catch (e) {
			uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
		}
	})

		const filteredSpots = computed(() => {
		let result = allSpots.value
		
		if (searchText.value) {
			result = result.filter(s => s.name.includes(searchText.value))
		}
		
		if (activeCategory.value !== 'all') {
			if (activeCategory.value === '5a') {
				result = result.filter(s => s.level === '5A')
			} else if (activeCategory.value === 'world') {
				result = result.filter(s => s.tags.some(t => t.includes('世界')))
			} else {
				result = result.filter(s => s.category === activeCategory.value)
			}
		}
		
		if (selectedLevel.value) {
			result = result.filter(s => s.level === selectedLevel.value)
		}
		
		if (selectedCity.value) {
			result = result.filter(s => s.location.includes(selectedCity.value))
		}
		
		return result
	})
	
	const displaySpots = computed(() => {
		return filteredSpots.value.slice(0, currentPage.value * pageSize)
	})
	
	const has5ATag = (tags) => {
		return tags.some(t => t.includes('AAAAA'))
	}
	
	const hasWorldTag = (tags) => {
		return tags.some(t => t.includes('世界'))
	}
	
	const handleSearch = () => {
		currentPage.value = 1
		searchFocused.value = false
	}
	
	const clearSearch = () => {
		searchText.value = ''
		currentPage.value = 1
	}
	
	const focusSearch = () => {
		searchFocused.value = true
	}
	
	const loadMore = () => {
		if (loading.value) return
		if (displaySpots.value.length >= filteredSpots.value.length) return
		
		loading.value = true
		setTimeout(() => {
			currentPage.value++
			loading.value = false
		}, 1000)
	}
	
	const onRefresh = () => {
		refreshing.value = true
		currentPage.value = 1
		setTimeout(() => {
			refreshing.value = false
		}, 1000)
	}
	
	const applyFilter = () => {
		currentPage.value = 1
		showFilter.value = false
	}
	
	const resetFilter = () => {
		selectedLevel.value = ''
		selectedCity.value = ''
	}
	
	const goToDetail = (id) => {
		uni.navigateTo({
			url: '/pages/detail/detail?id=' + id
		})
	}
</script>

<style>
	.spot-list-page {
		min-height: 100vh;
		background: #F5E6D3;
		padding-bottom: env(safe-area-inset-bottom);
	}

