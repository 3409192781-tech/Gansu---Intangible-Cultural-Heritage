<template>
	<view class="settings-page">
		<view class="settings-header">
			<view class="header-bg-layer">
				<view class="header-overlay"></view>
				<view class="header-pattern"></view>
			</view>
			<view class="header-content">
				<view class="header-icon-wrap">
					<view class="header-icon"></view>
				</view>
				<text class="header-title">设置</text>
				<text class="header-subtitle">个性化你的云游体验</text>
			</view>
		</view>

		<view class="settings-content">
			<view class="settings-group">
				<view class="group-header">
					<view class="group-icon-wrap group-icon-policy"><image src="/static/icons/menu-policy.svg" mode="aspectFit" class="group-icon-img"></image></view>
					<text class="group-title">协议与政策</text>
					<view class="group-line"></view>
				</view>
				<view class="settings-item" @click="goToPrivacy">
					<view class="item-icon item-icon-privacy"><image src="/static/icons/menu-privacy.svg" mode="aspectFit" class="item-icon-img"></image></view>
					<text class="settings-text">隐私政策</text>
					<view class="item-arrow"></view>
				</view>
				<view class="settings-item" @click="goToAgreement">
					<view class="item-icon item-icon-agreement"><image src="/static/icons/menu-agreement.svg" mode="aspectFit" class="item-icon-img"></image></view>
					<text class="settings-text">用户协议</text>
					<view class="item-arrow"></view>
				</view>
				<view class="settings-item" @click="goToAbout">
					<view class="item-icon item-icon-about"><image src="/static/icons/menu-about.svg" mode="aspectFit" class="item-icon-img"></image></view>
					<text class="settings-text">关于我们</text>
					<view class="item-arrow"></view>
				</view>
			</view>

			<view class="settings-group">
				<view class="group-header">
					<view class="group-icon-wrap group-icon-feedback"><image src="/static/icons/menu-feedback.svg" mode="aspectFit" class="group-icon-img"></image></view>
					<text class="group-title">帮助与反馈</text>
					<view class="group-line"></view>
				</view>
				<view class="settings-item" @click="handleFeedback">
					<view class="item-icon item-icon-suggest"><image src="/static/icons/menu-suggest.svg" mode="aspectFit" class="item-icon-img"></image></view>
					<text class="settings-text">意见反馈</text>
					<view class="item-arrow"></view>
				</view>
				<view class="settings-item" @click="handleContact">
					<view class="item-icon item-icon-contact"><image src="/static/icons/menu-contact.svg" mode="aspectFit" class="item-icon-img"></image></view>
					<text class="settings-text">联系客服</text>
					<view class="item-arrow"></view>
				</view>
			</view>
		</view>

		<!-- 退出登录 -->
		<view class="logout-section" v-if="loggedIn">
			<view class="logout-btn" @click="handleLogout">
				<text class="logout-text">退出登录</text>
			</view>
		</view>

		<view class="settings-footer">
			<view class="footer-decoration"></view>
			<text class="footer-text">陇韵匠心 v1.1.0</text>
			<text class="footer-sub">© 2026 陇韵匠心小程序</text>
			<text class="footer-slogan">丝路文化 · 敦煌风韵</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { isLoggedIn } from '../../utils/identity'

const loggedIn = ref(false)
onMounted(() => {
  loggedIn.value = isLoggedIn()
})

const goToPrivacy = () => {
	uni.navigateTo({ url: '/pages/privacy/privacy' })
}

const goToAgreement = () => {
	uni.navigateTo({ url: '/pages/agreement/agreement' })
}

const goToAbout = () => {
	uni.showModal({
		title: '关于我们',
		content: '陇韵匠心小程序致力于为游客提供甘肃省旅游景点、非遗文化、特色美食等信息的一站式服务平台。',
		showCancel: false
	})
}

const handleFeedback = () => {
	uni.showModal({
		title: '意见反馈',
		content: '感谢您的反馈！如有问题，请联系客服：13800000000',
		showCancel: false
	})
}

const handleContact = () => {
	uni.makePhoneCall({ phoneNumber: '13800000000' })
}

const handleLogout = () => {
	uni.showModal({
		title: '退出登录',
		content: '退出后收藏和订单将不会同步，确定退出？',
		success: (res) => {
			if (res.confirm) {
				uni.removeStorageSync('token')
				uni.removeStorageSync('userInfo')
				uni.showToast({ title: '已退出', icon: 'none' })
				setTimeout(() => {
					uni.switchTab({ url: '/pages/index/index' })
				}, 600)
			}
		}
	})
}
</script>

