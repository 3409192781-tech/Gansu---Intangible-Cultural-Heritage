<template>
	<view class="user-page">
		<view class="user-header">
			<view class="header-bg-layer">
				<view class="header-overlay"></view>
				<view class="header-pattern"></view>
			</view>
			<view class="user-info" @click="handleUserClick">
				<view class="avatar" :class="{ 'avatar-guest': !loggedIn }">
					<image v-if="loggedIn && userAvatar" class="avatar-img" :src="userAvatar" mode="aspectFill"></image>
					<text v-else class="avatar-text">{{avatarText}}</text>
				</view>
				<view class="user-detail">
					<text class="user-name">{{ loggedIn ? userNickName : '点击登录' }}</text>
					<text class="user-id">{{ loggedIn ? '已登录' : '登录后可同步收藏和订单' }}</text>
				</view>
				<view class="edit-btn" v-if="loggedIn">
					<text class="edit-text">›</text>
				</view>
			</view>
			<view class="user-stats">
				<view class="stat-item" @click="goToCollection">
					<text class="stat-value">{{favoriteCount}}</text>
					<text class="stat-label">收藏</text>
					<view class="stat-decoration"></view>
				</view>
				<view class="stat-divider"></view>
				<view class="stat-item" @click="goToHistory">
					<text class="stat-value">{{historyCount}}</text>
					<text class="stat-label">浏览</text>
					<view class="stat-decoration"></view>
				</view>
			</view>
		</view>

		<view class="user-menu">
			<view class="menu-group">
				<view class="menu-header">
					<view class="menu-icon-wrap icon-spots"><image src="/static/icons/menu-trip.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-group-title">我的行程</text>
					<view class="menu-line"></view>
				</view>
				<view class="menu-item" @click="goToMySpots">
					<view class="menu-icon menu-icon-spots"><image src="/static/icons/menu-spot.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">我的景点</text>
					<view class="menu-arrow"></view>
				</view>
				<view class="menu-item" @click="goToMyCulture">
					<view class="menu-icon menu-icon-culture"><image src="/static/icons/menu-culture.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">非遗收藏</text>
					<view class="menu-arrow"></view>
				</view>
				<view class="menu-item" @click="goToMyFood">
					<view class="menu-icon menu-icon-food"><image src="/static/icons/menu-food.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">美食记录</text>
					<view class="menu-arrow"></view>
				</view>
				<view class="menu-item" @click="goToMyOrders">
					<view class="menu-icon menu-icon-orders"><image src="/static/icons/menu-food.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">我的订单</text>
					<view class="menu-arrow"></view>
				</view>
			</view>

			<view class="menu-group">
				<view class="menu-header">
					<view class="menu-icon-wrap icon-services"><image src="/static/icons/menu-service.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-group-title">服务中心</text>
					<view class="menu-line"></view>
				</view>
				<view class="menu-item" @click="goToHelp">
					<view class="menu-icon menu-icon-help"><image src="/static/icons/menu-help.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">帮助中心</text>
					<view class="menu-arrow"></view>
				</view>
			</view>

			<view class="menu-group">
				<view class="menu-header">
					<view class="menu-icon-wrap icon-settings"><image src="/static/icons/menu-settings.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-group-title">设置</text>
					<view class="menu-line"></view>
				</view>
				<view class="menu-item" @click="goToSettings">
					<view class="menu-icon menu-icon-settings"><image src="/static/icons/menu-gear.svg" mode="aspectFit" class="menu-icon-img"></image></view>
					<text class="menu-text">设置</text>
					<view class="menu-arrow"></view>
				</view>
			</view>
		</view>

		<view class="user-footer">
			<view class="footer-decoration"></view>
			<text class="footer-text">陇韵匠心 · 带你领略丝路文化</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { api } from '../../utils/api'
import { getDeviceId, isLoggedIn, getUserInfo } from '../../utils/identity'

const loggedIn = ref(false)
const userNickName = ref('游客')
const userAvatar = ref('')
const favoriteCount = ref(0)
const historyCount = ref(0)

const syncLoginState = () => {
	const state = isLoggedIn()
	loggedIn.value = state
	if (state) {
		const info = getUserInfo()
		userNickName.value = (info && info.nickName) ? info.nickName : '微信用户'
		userAvatar.value = (info && info.avatarUrl) ? info.avatarUrl : ''
	} else {
		userNickName.value = '游客'
		userAvatar.value = ''
	}
}
syncLoginState()

const avatarText = computed(() => {
	const name = userNickName.value
	if (!name || name.length === 0) return '游'
	return name.charAt(0)
})

const handleUserClick = () => {
	if (!loggedIn.value) {
		uni.navigateTo({ url: '/pages/login/login' })
	} else {
		uni.showToast({ title: '已登录微信账号', icon: 'none' })
	}
}

const loadStats = async () => {
	try {
		const deviceId = getDeviceId()
		const data = await api.favorites.get(deviceId)
		if (data) {
			const spots = data.spots?.length || 0
			const cultures = data.cultures?.length || 0
			const foods = data.foods?.length || 0
			favoriteCount.value = spots + cultures + foods
		}
	} catch (e) {
		favoriteCount.value = 0
	}

	try {
		const raw = uni.getStorageSync('browseHistory')
		const history = raw ? JSON.parse(raw) : []
		historyCount.value = history.length
	} catch (e) {
		historyCount.value = 0
	}
}

onShow(() => {
	syncLoginState()
	loadStats()
})

const goToCollection = () => {
	uni.showToast({ title: '共收藏 ' + favoriteCount.value + ' 项', icon: 'none' })
}

const goToHistory = () => {
	uni.showToast({ title: '共浏览 ' + historyCount.value + ' 项', icon: 'none' })
}

const goToMySpots = () => {
	uni.navigateTo({ url: '/pages/my-spots/my-spots' })
}

const goToMyCulture = () => {
	uni.navigateTo({ url: '/pages/my-culture/my-culture' })
}

const goToMyFood = () => {
	uni.navigateTo({ url: '/pages/my-food/my-food' })
}

const goToMyOrders = () => {
	uni.navigateTo({ url: '/pages/my-orders/my-orders' })
}

const goToHelp = () => {
	uni.navigateTo({ url: '/pages/help/help' })
}

const goToSettings = () => {
	uni.navigateTo({ url: '/pages/settings/settings' })
}
</script>

