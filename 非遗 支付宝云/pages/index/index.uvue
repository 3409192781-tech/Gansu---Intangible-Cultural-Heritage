<script setup lang="uts">
	import { ref } from 'vue'
	import { images } from '../../data/images'
	
	const currentBanner = ref(0)
	
	const banners = [
		{ id: 1, image: images.banner1, title: '敦煌彩塑', desc: '千年非遗 · 匠心传承' },
		{ id: 6, image: images.banner2, title: '庆阳香包', desc: '传统手工艺 · 国家级非遗' },
		{ id: 7, image: images.banner3, title: '兰州牛肉面', desc: '中华第一面 · 舌尖非遗' }
	]
	
	const onBannerChange = (e: any) => {
		currentBanner.value = e.detail.current
	}
	
	const quickEntries = [
		{ icon: '/static/icons/map.svg', text: '地图导览', iconClass: 'entry-icon-map', innerClass: '' },
		{ icon: '/static/icons/spot.svg', text: '景点推荐', iconClass: 'entry-icon-spot', innerClass: '' },
		{ icon: '/static/icons/culture.svg', text: '非遗文化', iconClass: 'entry-icon-culture', innerClass: '' },
		{ icon: '/static/icons/food.svg', text: '特色美食', iconClass: 'entry-icon-food', innerClass: '' },
		{ icon: '/static/icons/ticket.svg', text: '门票预订', iconClass: 'entry-icon-ticket', innerClass: '' },
		{ icon: '/static/icons/phone.svg', text: '联系我们', iconClass: 'entry-icon-phone', innerClass: '' }
	]
	
	const hotSpots = [
		{ id: 1, name: '敦煌彩塑', image: images.spot1, tags: ['国家级非遗', '敦煌文化'], location: '酒泉市敦煌市', rating: '4.9' },
		{ id: 2, name: '临夏砖雕', image: images.spot2, tags: ['传统美术', '国家级非遗'], location: '临夏州临夏市', rating: '4.8' },
		{ id: 3, name: '天水雕漆', image: images.spot3, tags: ['传统技艺', '国家级非遗'], location: '天水市', rating: '4.9' },
		{ id: 4, name: '夜光杯雕', image: images.spot4, tags: ['传统美术', '酒泉特产'], location: '酒泉市', rating: '4.8' },
		{ id: 5, name: '保安腰刀', image: images.spot5, tags: ['传统技艺', '国家级非遗'], location: '临夏州积石山县', rating: '4.7' }
	]
	
	const cultures = [
		{ name: '敦煌彩塑', desc: '千年艺术瑰宝', image: images.culture1 },
		{ name: '花儿', desc: '国家级非遗', image: images.culture2 },
		{ name: '庆阳香包', desc: '传统手工艺', image: images.culture3 },
		{ name: '临夏砖雕', desc: '传统美术', image: images.culture4 },
		{ name: '敦煌曲子戏', desc: '西北戏曲之魂', image: images.culture5 },
		{ name: '兰州太平鼓', desc: '黄河文化', image: images.culture6 }
	]
	
	const foods = [
		{ name: '兰州牛肉面', area: '兰州', image: images.food1 },
		{ name: '陇西腊肉', area: '定西', image: images.food2 },
		{ name: '静宁烧鸡', area: '平凉', image: images.food3 },
		{ name: '天水呱呱', area: '天水', image: images.food4 }
	]
	
	const events = [
		{ month: '7月', day: '15日', title: '敦煌飞天文化节', location: '酒泉市敦煌市' },
		{ month: '8月', day: '8日', title: '张掖丹霞旅游节', location: '张掖市临泽县' },
		{ month: '9月', day: '1日', title: '嘉峪关国际马拉松', location: '嘉峪关市' },
		{ month: '10月', day: '1日', title: '国庆文化旅游周', location: '全省各地' }
	]
	
	const goToDetail = (id) => {
		uni.navigateTo({
			url: `/pages/detail/detail?id=${id}`
		})
	}
	
	const handleQuickEntry = (item) => {
		if (item.text === '地图导览') {
			uni.switchTab({ url: '/pages/map/map' })
		} else if (item.text === '联系我们') {
			uni.makePhoneCall({ phoneNumber: '19993147273' })
		} else {
			uni.showToast({ title: `${item.text}功能开发中`, icon: 'none' })
		}
	}
	
	const viewMore = (type) => {
		uni.showToast({ title: `${type}更多功能开发中`, icon: 'none' })
	}
	
	const handleSearch = () => {
		uni.showToast({ title: '搜索功能开发中', icon: 'none' })
	}
</script>

