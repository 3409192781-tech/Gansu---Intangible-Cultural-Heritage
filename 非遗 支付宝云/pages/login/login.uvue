<template>
	<view class="login-page">
		<view class="bg-layer">
			<image class="bg-image" :src="loginBg" mode="aspectFill"></image>
			<view class="bg-overlay"></view>
			<view class="bg-pattern"></view>
		</view>
		
		<view class="cloud-decoration cloud-1"></view>
		<view class="cloud-decoration cloud-2"></view>
		<view class="cloud-decoration cloud-3"></view>
		
		<view class="login-section">
			<view class="login-btn" @click="handleLogin">
				<view class="btn-decoration-left"></view>
				<view class="btn-content">
					<view class="btn-icon-wrap">
						<view class="btn-icon"></view>
					</view>
					<text class="login-text">微信一键登录</text>
				</view>
				<view class="btn-decoration-right"></view>
			</view>
			<view class="privacy-text">
				<text>登录即表示同意</text>
				<text class="link" @click="goToAgreement">《用户协议》</text>
				<text>和</text>
				<text class="link" @click="goToPrivacy">《隐私政策》</text>
