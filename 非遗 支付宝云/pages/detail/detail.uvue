	const detail = reactive({
		name: '',
		rating: '',
		reviews: '',
		tags: [],
		location: '',
		description: '',
		openTime: '',
		ticketInfo: '',
		transport: '',
		tips: [],
		images: []
	})
	
	onLoad((options) => {
		const spotId = options?.id || '1'
		const spot = spotsData.find(s => s.id === spotId)
		if (spot) {
			Object.assign(detail, spot)
		} else {
			Object.assign(detail, spotsData[0])
		}
	})
	
	const handleShare = () => {
		uni.showToast({ title: '分享功能开发中', icon: 'none' })
	}
	
	const handleCollect = () => {
		isCollected.value = !isCollected.value
		uni.showToast({ title: isCollected.value ? '收藏成功' : '取消收藏', icon: 'none' })
	}
	
	const handleNav = () => {
		uni.showToast({ title: '导航功能开发中', icon: 'none' })
	}
	
	const handleBook = () => {
		uni.showToast({ title: '预订功能开发中', icon: 'none' })
	}
</script>

