			tips: ['可以亲手体验制作', '建议购买成品作为伴手礼', '端午节期间有香包文化节', '注意辨别手工和机制'],
			images: [
				'/static/banner2.jpg',
				'/static/culture3.jpg',
				'/static/culture2.jpg'
			]
		},
		{
			id: '7',
			name: '兰州牛肉面制作技艺',
			rating: '4.9',
			reviews: '15320',
			tags: ['国家级非遗', '中华美食', '兰州名片'],
			location: '甘肃省兰州市',
			description: '兰州牛肉面制作技艺是甘肃省兰州市的传统面食制作技艺，被誉为"中华第一面"。兰州牛肉面以"一清二白三红四绿五黄"为特色，汤清、肉烂、面细，口感独特，是兰州最具代表性的美食文化符号。',
			openTime: '全天开放\n（多数店铺：06:00 - 22:00）',
			ticketInfo: '免费参观\n品尝：15-30元/碗',
			transport: '公交：乘1路、6路、9路等多路公交到西关站\n地铁：1号线西关站',
			tips: ['建议早上去吃最新鲜', '可以加肉加蛋', '推荐老字号店铺', '小心烫口'],
			images: [
				'/static/banner3.jpg',
				'/static/food1.jpg',
				'/static/food2.jpg'
			]
