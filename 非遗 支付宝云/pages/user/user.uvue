<script setup lang="uts">
	import { ref, computed } from 'vue'
	
	const userInfo = ref({
		openid: uni.getStorageSync('userInfo')?.openid || 'test_openid_001',
		nickName: uni.getStorageSync('userInfo')?.nickName || '游客'
	})
	
	const avatarText = computed(() => {
		const name = userInfo.value.nickName
		if (!name || name.length === 0) return '游'
		return name.charAt(0)
	})
	
	const userIdShort = computed(() => {
		const id = userInfo.value.openid
		if (!id || id.length < 8) return '00000000'
		return id.slice(-8)
	})
	
	const goToCollection = () => {
		uni.showToast({ title: '收藏功能开发中', icon: 'none' })
	}
	
	const goToHistory = () => {
		uni.showToast({ title: '浏览记录功能开发中', icon: 'none' })
	}
	
	const goToOrders = () => {
		uni.showToast({ title: '订单功能开发中', icon: 'none' })
	}
	
	const goToMySpots = () => {
		uni.showToast({ title: '我的景点功能开发中', icon: 'none' })
	}
	
	const goToMyCulture = () => {
		uni.showToast({ title: '非遗收藏功能开发中', icon: 'none' })
	}
	
	const goToMyFood = () => {
		uni.showToast({ title: '美食记录功能开发中', icon: 'none' })
	}
	
	const goToMessages = () => {
		uni.showToast({ title: '消息通知功能开发中', icon: 'none' })
	}
	
	const goToCoupons = () => {
		uni.showToast({ title: '优惠券功能开发中', icon: 'none' })
	}
	
	const goToHelp = () => {
		uni.showToast({ title: '帮助中心功能开发中', icon: 'none' })
	}
	
	const goToSettings = () => {
		uni.navigateTo({
			url: '/pages/settings/settings'
		})
	}
</script>

