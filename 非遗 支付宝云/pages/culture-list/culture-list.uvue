		{ id: '40', name: '裕固族服饰', image: 'https://gansu-culture.xyz/details/detail40-1.jpg', tags: ['国家级非遗', '民俗', '裕固族特色'], location: '张掖市肃南县', rating: '4.7', reviews: '3120' },
		{ id: '41', name: '洮砚制作技艺', image: 'https://gansu-culture.xyz/details/detail41-1.jpg', tags: ['国家级非遗', '传统技艺', '定西特色'], location: '定西市岷县', rating: '4.8', reviews: '4780' },
		{ id: '42', name: '环县道情皮影戏', image: 'https://gansu-culture.xyz/details/detail42-1.jpg', tags: ['世界级非遗', '传统戏剧', '庆阳特色'], location: '庆阳市环县', rating: '4.9', reviews: '5890' },
		{ id: '43', name: '唢呐艺术', image: 'https://gansu-culture.xyz/details/detail43-1.jpg', tags: ['国家级非遗', '传统音乐', '庆阳特色'], location: '庆阳市西峰区', rating: '4.6', reviews: '2780' },
		{ id: '44', name: '七夕节（乞巧节）', image: 'https://gansu-culture.xyz/details/detail44-1.jpg', tags: ['国家级非遗', '民俗', '陇南特色'], location: '陇南市西和县', rating: '4.8', reviews: '6520' },
		{ id: '45', name: '陇剧', image: 'https://gansu-culture.xyz/details/detail45-1.jpg', tags: ['国家级非遗', '传统戏剧', '甘肃特色'], location: '兰州市', rating: '4.7', reviews: '4120' }
	]
	
	const filteredCultures = computed(() => {
		let result = cultures
		
		if (searchText.value) {
			const keyword = searchText.value.toLowerCase()
			result = result.filter(c => 
				c.name.toLowerCase().includes(keyword) ||
				c.location.toLowerCase().includes(keyword)
			)
		}
		
		if (selectedLevel.value) {
			result = result.filter(c => c.tags.some(t => t.includes(selectedLevel.value)))
		}
		
		if (selectedType.value) {
			result = result.filter(c => c.tags.some(t => t.includes(selectedType.value)))
		}
		
		if (activeCategory.value !== 'all') {
			const categoryMap: Record<string, string[]> = {
				'world': ['世界级'],
				'national': ['国家级'],
				'provincial': ['省级'],
				'city': ['市级'],
				'art': ['传统美术'],
				'music': ['传统音乐'],
				'dance': ['传统舞蹈'],
				'drama': ['传统戏剧'],
				'skill': ['传统技艺', '传统手工艺']
			}
			const keywords = categoryMap[activeCategory.value] || []
			result = result.filter(c => c.tags.some(t => keywords.some(k => t.includes(k))))
		}
		
		return result
	})
	
	const displayCultures = computed(() => {
		return filteredCultures.value.slice(0, currentPage.value * pageSize)
	})
	
	const focusSearch = () => {
		searchFocused.value = true
	}
	
	const clearSearch = () => {
		searchText.value = ''
	}
	
	const handleSearch = () => {
		currentPage.value = 1
	}
	
	const goToDetail = (id) => {
		uni.navigateTo({
			url: '/pages/detail/detail?id=' + id
		})
	}
	
	const hasLevelTag = (tags: string[], level: string) => {
		return tags.some(t => t.includes(level))
	}
	
	const loadMore = () => {
		if (loading.value) return
		if (displayCultures.value.length >= filteredCultures.value.length) return
		
		loading.value = true
		setTimeout(() => {
			currentPage.value++
			loading.value = false
		}, 500)
	}
	
	const onRefresh = () => {
		refreshing.value = true
		currentPage.value = 1
		setTimeout(() => {
			refreshing.value = false
		}, 1000)
	}
	
	const resetFilter = () => {
		selectedLevel.value = ''
		selectedType.value = ''
	}
	
	const confirmFilter = () => {
		currentPage.value = 1
		showFilter.value = false
	}
</script>

